#!/bin/sh
# postinst of w4os-engine: the system layout of the machine (the account the instances run as, the folders, w4os.conf), made
# by the engine when it is not there (the /etc/opensim/opensim.conf of before w4os moved to /etc/w4os/w4os.conf); one install
# profile per OpenSimulator release installed (also when a release comes or goes, see the trigger); the files the grids that exist are missing, and the options of a grid its simulators miss laid again (the
# simulators take them at their next start). Nothing is done twice, what is there is left as it is.
set -e

engine=/usr/share/w4os-engine/bin

case "$1" in
    configure)
        php "$engine/opensim-layout.php" || {
            echo "w4os-engine: could not make the system layout" >&2
            exit 1
        }
        php "$engine/opensim-profiles.php" ||
            echo "w4os-engine: could not update the install profiles in /etc/w4os/w4os.conf" >&2
        # The files a grid needs that it does not have yet, and the options its simulators miss, made as the account of the instances
        if [ -d /etc/opensim/grids ] && getent passwd opensim >/dev/null; then
            runuser -u opensim -- php "$engine/opensim-complete-grids.php" || true
        fi
        ;;
    triggered)
        [ -f /etc/w4os/w4os.conf ] && php "$engine/opensim-profiles.php" || true
        ;;
esac

exit 0
