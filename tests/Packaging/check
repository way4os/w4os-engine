#!/usr/bin/env bash
# Tries the files of dist/ (made by dev/build.sh) in a clean container (podman): the Debian package installs with the
# package it needs and loads as an unprivileged user, the zip is used without composer. Exits non-zero when a check fails.
#
#   tests/Packaging/check --connection NAME|--local [base image]     default: Debian 12; docker.io/library/ubuntu:24.04 for another
#   DEPS=folder                              where the Debian packages of the other projects are (default: ../opensim-rest-php/dist)
#   MEMORY=400m                              memory of the container
#   Both can be set in tests/.env (see tests/.env.example), after the .env of the project.

set -eo pipefail
# Where the container runs, said on the command line: --connection NAME (a podman system connection, --container NAME is the
# same), or --local for the podman of this machine. Never an environment variable: it may not be exported, sudo drops it. On
# macOS one of them is required (its podman machine is too small for this); elsewhere the podman of the machine is the default.
CONNECTION= LOCAL=0
while [[ "${1:-}" == --* ]]; do
    case $1 in
    --connection | --container) CONNECTION=${2:-}; [[ -n $CONNECTION ]] || { echo "check: $1 needs the name of a podman connection" >&2; exit 2; }; shift 2 ;;
    --connection=* | --container=*) CONNECTION=${1#*=}; shift ;;
    --local) LOCAL=1; shift ;;
    *) echo "check: unknown option $1" >&2; exit 2 ;;
    esac
done
if [[ -z $CONNECTION && $LOCAL != 1 && $(uname -s) == Darwin ]]; then
    echo "check: say where the container runs: --connection NAME (podman system connection list), or --local for this Mac" >&2
    exit 2
fi
podman=(podman ${CONNECTION:+--connection "$CONNECTION"})
BASE=${1:-docker.io/library/debian:bookworm}
cd "$(dirname "$0")/../.."
BASE_DIR=$PWD
[[ -f vendor/bin/bash-helpers ]] || { echo "bash-tools is not installed: composer install" >&2; exit 1; }
source vendor/bin/bash-helpers

# The environment of the project (.env) and the one of the tests (tests/.env): MEMORY...
ENV_SLUG=tests read_env || true
# The machine the container runs on, as podman itself says it: a named connection must exist and answer
if [[ -n $CONNECTION ]] && ! podman system connection list --format '{{.Name}}' 2>/dev/null | grep -qxF -- "$CONNECTION"; then
    echo "check: $CONNECTION is not a podman connection (podman system connection list)" >&2
    exit 2
fi
podman_host=$("${podman[@]}" info --format '{{.Host.Hostname}}' 2>/dev/null) || { echo "check: podman does not answer${CONNECTION:+ on $CONNECTION}" >&2; exit 2; }
log "Podman on $podman_host${CONNECTION:+ (connection $CONNECTION)}"
DEPS=${DEPS:-$PWD/../opensim-rest-php/dist}

# What the container needs is sent to it as a tar stream, so it can run on any machine:
# --connection NAME (see podman system connection) uses the podman of another one
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
ln -s "$PWD/dist" "$stage/dist"
ln -s "$DEPS" "$stage/deps"
COPYFILE_DISABLE=1 tar -chf - -C "$stage" dist deps | "${podman[@]}" run --rm -i --memory="${MEMORY:-400m}" "$BASE" bash -c '
tar -xf - --no-same-owner --warning=no-unknown-keyword -C /
status=0
check() { if eval "$2"; then echo "   ok: $1"; else echo "   FAILED: $1"; status=1; fi; }
# A previous version of a package, which had the libraries bundled as folders of vendor/magicoli (dpkg does not
# replace a folder by a link when it upgrades): installed in place of the real one
previous() { # package, libraries
    local pkg=$1 root lib
    shift
    root=/tmp/previous-$pkg
    rm -rf $root
    mkdir -p $root/DEBIAN
    for lib in "$@"; do
        mkdir -p $root/usr/share/$pkg/vendor/magicoli/$lib
        : >$root/usr/share/$pkg/vendor/magicoli/$lib/bundled.php
    done
    : >$root/usr/share/$pkg/vendor/autoload.php
    printf "Package: $pkg\nVersion: 0.0.1\nArchitecture: all\nMaintainer: test <test@example.org>\nDescription: previous version, libraries bundled\n" >$root/DEBIAN/control
    dpkg-deb -b $root /tmp/previous-$pkg.deb >/dev/null
    dpkg -r $pkg >/dev/null 2>&1
    dpkg -i /tmp/previous-$pkg.deb >/dev/null 2>&1
}
loads() { php -r "require \"$1/vendor/autoload.php\"; exit(class_exists(\"OpenSim_Rest\") && class_exists(\"W4OS\\Engine\\Config\\Layout\") ? 0 : 1);"; }
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq >/dev/null
apt-get install -y -qq unzip /deps/*.deb /dist/*.deb >/dev/null 2>&1

check "the package ships its libraries as links, whatever the machine that built it has" "dpkg-deb -c /dist/w4os-engine_*.deb | grep \"^l.*vendor/magicoli/opensim-rest-php -> /usr/share/opensim-rest-php\" >/dev/null && dpkg-deb -c /dist/w4os-engine_*.deb | grep \"^l.*vendor/magicoli/container-tools -> /usr/share/container-tools\" >/dev/null"
check "the package is installed, it depends on opensim-rest-php" "dpkg -s w4os-engine | grep -q \"^Depends:.*opensim-rest-php\""
check "its files are in /usr/share/w4os-engine" "[ -f /usr/share/w4os-engine/src/Config/Layout.php ] && [ -f /usr/share/w4os-engine/vendor/autoload.php ]"
check "rest-php comes from its own package, by a link" "[ -L /usr/share/w4os-engine/vendor/magicoli/opensim-rest-php ] && [ -f /usr/share/w4os-engine/vendor/magicoli/opensim-rest-php/class-rest.php ]"
check "the engine loads, with its dependencies" "loads /usr/share/w4os-engine"
check "it loads as an unprivileged user, it writes nothing" "runuser -u nobody -- php -r \"require \\\"/usr/share/w4os-engine/vendor/autoload.php\\\"; echo 1;\" | grep -q 1"
# The upgrade from the name of before w4os, from a version that bundled rest-php
dpkg -r opensim-engine w4os-engine >/dev/null 2>&1
previous opensim-engine opensim-rest-php
# The web configs of the API written from the snippets of before w4os (opensim web <grid> api)
mkdir -p /etc/apache2/conf-available /etc/php/8.4/fpm/pool.d
printf "Listen 127.0.0.1:8780\n<VirtualHost 127.0.0.1:8780>\n\tDocumentRoot /usr/share/opensim-engine/public\n\tAlias /api /usr/share/opensim-engine/public/index.php\n\tSetHandler \"proxy:unix:/run/php/opensim-api.sock|fcgi://localhost\"\n</VirtualHost>\n" >/etc/apache2/conf-available/opensim-api-demo.conf
printf "[opensim-api]\nuser = opensim\nlisten = /run/php/opensim-api.sock\n" >/etc/php/8.4/fpm/pool.d/opensim-api.conf
# The empty package first, as apt orders them: dpkg alone does not deconfigure what the new one breaks
dpkg -i /dist/opensim-engine_*.deb /dist/w4os-engine_*.deb >/dev/null 2>&1
check "the web configs of the API name the paths, the socket and the pool of w4os-engine" "! grep -qE \"opensim-engine|opensim-api\" /etc/apache2/conf-available/opensim-api-demo.conf /etc/php/8.4/fpm/pool.d/opensim-api.conf && grep -q \"DocumentRoot /usr/share/w4os-engine/public\" /etc/apache2/conf-available/opensim-api-demo.conf && grep -q \"^\\[w4os-api\\]\" /etc/php/8.4/fpm/pool.d/opensim-api.conf && [ -f /usr/share/w4os-engine/public/index.php ]"
check "an upgrade from opensim-engine brings w4os-engine, the old name an empty package" "dpkg-query -W -f=\"\\\${db:Status-Abbrev}\\n\" w4os-engine opensim-engine | grep -c ^ii | grep -qx 2 && dpkg -s opensim-engine | grep -q \"^Depends:.*w4os-engine\" && [ ! -e /usr/share/opensim-engine ]"
check "the engine loads after the upgrade, rest-php by a link" "[ -L /usr/share/w4os-engine/vendor/magicoli/opensim-rest-php ] && loads /usr/share/w4os-engine"

# The engine API served as opensim web <grid> api made it before w4os, by Apache and its pool: it answers after the upgrade
apt-get install -y -qq apache2 php-fpm curl >/dev/null 2>&1
php=$(php -r "echo PHP_MAJOR_VERSION . \".\" . PHP_MINOR_VERSION;")
snippet() { php -r "require \"/usr/share/w4os-engine/vendor/autoload.php\"; echo W4OS\\Engine\\Provisioning\\Web\\Snippets::$1;" | sed -e "s#/usr/share/w4os-engine#/usr/share/opensim-engine#g" -e "s#w4os-api#opensim-api#g"; }
snippet "pool(\"opensim\")" >/etc/php/$php/fpm/pool.d/opensim-api.conf
snippet "api(\"apache\", \"demo\")" >/etc/apache2/conf-available/opensim-api-demo.conf
a2enmod -q proxy_fcgi >/dev/null 2>&1; a2enconf -q opensim-api-demo >/dev/null 2>&1
/var/lib/dpkg/info/w4os-engine.postinst configure >/dev/null 2>&1
"php-fpm$php" -D && apache2ctl start >/dev/null 2>&1; sleep 2
check "the API made by opensim web <grid> api before w4os answers after the upgrade, on 127.0.0.1:8780" "! grep -qE \"/usr/share/opensim-engine|opensim-api\\.sock|^\\[opensim-api\\]\" /etc/apache2/conf-available/opensim-api-demo.conf /etc/php/$php/fpm/pool.d/opensim-api.conf && [ \"\$(curl -s -o /dev/null -w %{http_code} http://127.0.0.1:8780/api/forms/grid)\" = 401 ]"

# The command line of before w4os, which links to /usr/share/opensim-engine, and the one of now, on w4os-engine: their command
# works while the engine it links to is there
cli() { # version, then "new" for the one of now
    local root=/tmp/cli-$1 link=/usr/share/opensim-cli/vendor/magicoli/opensim-engine target=/usr/share/opensim-engine
    rm -rf $root /tmp/w4os-cli
    if [ "${2:-}" = new ]; then
        link=/usr/share/w4os-cli/vendor/w4os/w4os-engine target=/usr/share/w4os-engine
        mkdir -p /tmp/w4os-cli/DEBIAN $root/DEBIAN
        printf "Package: w4os-cli\nVersion: $1\nArchitecture: all\nMaintainer: test <test@example.org>\nDescription: cli of now\nDepends: w4os-engine\nReplaces: opensim-cli (<< $1)\nBreaks: opensim-cli (<< $1)\n" >/tmp/w4os-cli/DEBIAN/control
        printf "Package: opensim-cli\nVersion: $1\nArchitecture: all\nMaintainer: test <test@example.org>\nDescription: transitional\nDepends: w4os-cli (= $1)\n" >$root/DEBIAN/control
        root=/tmp/w4os-cli
    else
        mkdir -p $root/DEBIAN
        printf "Package: opensim-cli\nVersion: $1\nArchitecture: all\nMaintainer: test <test@example.org>\nDescription: cli of before w4os\nDepends: opensim-engine\n" >$root/DEBIAN/control
    fi
    mkdir -p $root/usr/bin $root$(dirname $link)
    ln -s $target $root$link
    printf "#!/bin/sh\n[ -f $link/vendor/autoload.php ]\n" >$root/usr/bin/opensim
    chmod 755 $root/usr/bin/opensim
    dpkg-deb -b $root /tmp/$(basename $root).deb >/dev/null
    [ "${2:-}" != new ] || dpkg-deb -b /tmp/cli-$1 /tmp/opensim-cli-$1.deb >/dev/null
}
# Back to the engine of before w4os and its command line
before_w4os() {
    dpkg --purge opensim-cli w4os-cli w4os-engine opensim-engine >/dev/null 2>&1
    previous opensim-engine opensim-rest-php
    dpkg -i /tmp/cli-3.0.0~beta.4+48.g2a90112.deb >/dev/null 2>&1
}
# The command line works, or is not there: never installed and broken, nothing left half-configured
cli_sound() { { [ ! -e /usr/bin/opensim ] || /usr/bin/opensim; } && [ -z "$(dpkg --audit)" ]; }
cli 3.0.0~beta.4+48.g2a90112
cli 3.0.0~beta.4+71.gb7f3e96 new
check "w4os-engine breaks the command line and the helpers of before w4os" "dpkg-deb -f /dist/w4os-engine_*.deb Breaks | grep -q \"opensim-cli (<< 3.0.0~beta.4+70~)\" && dpkg-deb -f /dist/w4os-engine_*.deb Breaks | grep -q \"opensim-helpers (<< 3.0.0~beta.6+137~)\""
before_w4os
check "the command line of before w4os works with the engine of before" "dpkg-query -W -f=\"\\\${Version}\" opensim-cli | grep -qx 3.0.0~beta.4+48.g2a90112 && cli_sound"
apt-get install -y -qq --no-remove /dist/opensim-engine_*.deb /dist/w4os-engine_*.deb >/dev/null 2>&1 && refused=0 || refused=1
check "the engine alone, nothing removed: apt refuses, the command line of before still works" "[ \$refused = 1 ] && ! dpkg -s w4os-engine >/dev/null 2>&1 && cli_sound && /usr/bin/opensim"
apt-get install -y -qq /dist/opensim-engine_*.deb /dist/w4os-engine_*.deb >/dev/null 2>&1 || true
check "the engine alone: the command line of before is removed, never left broken" "dpkg -s w4os-engine >/dev/null 2>&1 && cli_sound"
before_w4os
apt-get install -y -qq /dist/opensim-engine_*.deb /dist/w4os-engine_*.deb /tmp/w4os-cli.deb /tmp/opensim-cli-3.0.0~beta.4+71.gb7f3e96.deb >/dev/null 2>&1
check "the engine with the command line of now: both upgraded, the command works" "dpkg-query -W -f=\"\\\${Version}\" opensim-cli | grep -qx 3.0.0~beta.4+71.gb7f3e96 && dpkg -s w4os-cli >/dev/null 2>&1 && [ -e /usr/bin/opensim ] && cli_sound"

mkdir /tmp/zip && cd /tmp/zip && unzip -q /dist/*.zip
check "the zip has the engine and its vendor folder" "[ -f w4os-engine/src/Config/Layout.php ] && [ -f w4os-engine/vendor/autoload.php ]"
check "the zip has rest-php in its vendor folder, as files" "[ ! -L w4os-engine/vendor/magicoli/opensim-rest-php ] && [ -f w4os-engine/vendor/magicoli/opensim-rest-php/class-rest.php ]"
check "the zip has no composer.lock, no tests of the engine" "[ ! -e w4os-engine/composer.lock ] && [ ! -e w4os-engine/tests ]"
check "the engine loads from the zip" "loads /tmp/zip/w4os-engine"
exit $status'
