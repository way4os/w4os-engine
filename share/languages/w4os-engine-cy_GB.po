msgctxt "error_account_disabled"
msgid "This avatar is disabled. Contact the managers of the grid."
msgstr "Mae’r afatar hwn wedi’i analluogi. Cysylltwch â rheolwyr y grid."

msgctxt "error_account_banned"
msgid "This avatar is banned."
msgstr "Mae'r afatar hwn wedi'i wahardd."

msgctxt "error_post_invalid"
msgid "A post has 1 to 1000 characters."
msgstr "Mae gan bostiad 1 i 1000 nod."

msgctxt "error_email_unconfirmed"
msgid ""
"This avatar is not active yet: confirm your email with the link of the mail "
"we sent you."
msgstr ""
"Nid yw’r afatar hwn yn weithredol eto: cadarnhewch eich ebost gyda’r ddolen "
"a anfonwyd atoch."

msgctxt "error_name_invalid"
msgid ""
"The first and the last name are made of letters, digits and hyphens, without "
"accents."
msgstr ""
"Mae’r enw cyntaf a’r cyfenw wedi’u gwneud o lythrennau, digidau a "
"chysylltnodau, heb acenion."

msgctxt "error_name_reserved"
msgid "This name is reserved, please choose another one."
msgstr "Mae’r enw hwn wedi’i gadw, dewiswch un arall."

msgctxt "error_name_taken"
msgid "An avatar already has this name, please choose another one."
msgstr "Mae gan afatar yr enw hwn yn barod, dewiswch un arall."

msgctxt "error_email_taken"
msgid "An avatar already has this email address."
msgstr "Mae gan afatar y cyfeiriad ebost hwn eisoes."

msgctxt "error_password_required"
msgid "Please fill in every field."
msgstr "Llenwch bob maes os gwelwch yn dda."

msgctxt "error_password_invalid"
msgid "The password must have 6 to 16 characters, without double quote."
msgstr "Rhaid i’r cyfrinair fod rhwng 6 ac 16 nod, heb ddyfynnod dwbl."

msgctxt "error_email_invalid"
msgid "This email address is not valid."
msgstr "Nid yw’r cyfeiriad ebost hwn yn ddilys."

msgctxt "error_email_required"
msgid "This avatar has no email address."
msgstr "Nid oes gan yr afatar hwn gyfeiriad ebost."

msgctxt "error_model_unknown"
msgid "This outfit is not available, please choose another one."
msgstr "Nid yw’r wisg hon ar gael, dewiswch un arall."

msgctxt "error_link_invalid"
msgid "This cannot be done."
msgstr "Nid yw hyn yn bosibl."

msgctxt "error_field_unknown"
msgid "This cannot be done."
msgstr "Nid yw hyn yn bosibl."

msgctxt "error_field_read_only"
msgid ""
"The name, the place and the size of a region are changed in its file, by its "
"operator."
msgstr ""
"Mae enw, lle a maint rhanbarth yn cael eu newid yn ei ffeil, gan ei "
"weithredwr."

msgctxt "error_flag_unknown"
msgid "This flag does not exist."
msgstr "Nid yw'r faner hon yn bodoli."

msgctxt "error_owner_unknown"
msgid "This avatar does not exist."
msgstr "Nid yw'r afatar hwn yn bodoli."

msgctxt "error_config_not_writable"
msgid ""
"This cannot be changed from here: the files of the grid belong to its server."
msgstr ""
"Ni ellir newid hyn o'r fan hon: mae ffeiliau'r grid yn perthyn i'w weinydd."

msgctxt "error_instance_user_required"
msgid ""
"This cannot be done from here: the simulators are started and stopped on "
"their server."
msgstr ""
"Ni ellir gwneud hyn o'r fan hon: mae'r efelychwyr yn cael eu cychwyn a'u "
"hatal ar eu gweinydd."

msgctxt "error_restore_conflict"
msgid "This backup holds what this server has already: nothing was replaced."
msgstr ""
"Mae'r copi wrth gefn hwn yn dal yr hyn sydd gan y gweinydd hwn eisoes: ni "
"ddisodlwyd dim."

msgctxt "error_source_not_readable"
msgid ""
"Some files of the older install cannot be read by the server: give it read "
"access to them first."
msgstr ""
"Ni all y gweinydd ddarllen rhai o ffeiliau'r hen osodiad: rhowch fynediad "
"darllen iddo atynt yn gyntaf."

msgctxt "error_estate_shared"
msgid ""
"The owner of this region is the owner of its estate, which has other "
"regions: change the owner of the estate."
msgstr ""
"Perchennog y rhanbarth hwn yw perchennog ei ystâd, sydd â rhanbarthau "
"eraill: newidiwch berchennog yr ystâd."

msgctxt "error_filter_unknown"
msgid "This list cannot be filtered this way."
msgstr "Ni ellir hidlo'r rhestr hon fel hyn."

msgctxt "error_filter_value_unknown"
msgid "This list cannot be filtered this way."
msgstr "Ni ellir hidlo'r rhestr hon fel hyn."

msgctxt "error_sort_unknown"
msgid "This list cannot be sorted this way."
msgstr "Ni ellir trefnu'r rhestr hon fel hyn."

msgctxt "error_role_unknown"
msgid "This role does not exist."
msgstr "Nid yw’r rôl hon yn bodoli."

msgctxt "error_role_level_conflict"
msgid "The level does not match the role."
msgstr "Nid yw’r lefel yn cyfateb i’r rôl."

msgctxt "error_token_refused"
msgid ""
"This link does not work: it has expired or it was already used. Ask for a "
"new one."
msgstr ""
"Nid yw’r ddolen hon yn gweithio: mae wedi dod i ben neu wedi’i defnyddio "
"eisoes. Gofynnwch am un newydd."

msgctxt "error_no_confirmation_pending"
msgid "This avatar does not wait for the confirmation of its email."
msgstr "Nid yw’r afatar hwn yn aros am gadarnhad ei ebost."

msgctxt "error_mail_failed"
msgid "The mail could not be sent. Please try again later."
msgstr "Doedd dim modd anfon yr ebost. Rhowch gynnig arall arni nes ymlaen."

msgctxt "notice_robust_restart_roles"
msgid ""
"Robust reads {key} when it starts: restart Robust ({restart}) so it gives "
"the region these roles when it registers again."
msgstr ""
"Mae Robust yn darllen {key} pan fydd yn cychwyn: ailgychwynnwch Robust "
"({restart}) fel ei fod yn rhoi'r rolau hyn i'r rhanbarth pan fydd yn "
"cofrestru eto."

msgctxt "notice_robust_config_line"
msgid ""
"{file} cannot be written by this process: set {line} in its [{section}], "
"then restart Robust ({restart})."
msgstr ""
"Ni all y broses hon ysgrifennu {file}: gosodwch {line} yn ei [{section}], "
"yna ailgychwynnwch Robust ({restart})."

msgctxt "notice_robust_config_remove"
msgid ""
"{file} cannot be written by this process: remove {key} from its [{section}], "
"then restart Robust ({restart})."
msgstr ""
"Ni all y broses hon ysgrifennu {file}: tynnwch {key} o'i [{section}], yna "
"ailgychwynnwch Robust ({restart})."

msgctxt "notice_robust_config_elsewhere"
msgid ""
"The config of Robust is not on this machine: set {line} in its [{section}], "
"so the region keeps its roles when it registers again."
msgstr ""
"Nid yw ffurfweddiad Robust ar y peiriant hwn: gosodwch {line} yn ei "
"[{section}], fel bod y rhanbarth yn cadw ei rolau pan fydd yn cofrestru eto."

msgctxt "notice_start_simulator"
msgid "Start the simulator {slug}: {command}"
msgstr "Cychwynnwch yr efelychydd {slug}: {command}"

msgctxt "notice_start_simulator_regions"
msgid "The simulator {slug} loads its new regions when it starts: {command}"
msgstr ""
"Mae'r efelychydd {slug} yn llwytho ei ranbarthau newydd pan fydd yn cychwyn: "
"{command}"

msgctxt "notice_region_roles_later"
msgid ""
"Robust gives {region} its roles ({roles}) from its config, read when it "
"starts: restart Robust ({restart}) before starting {slug}, or once the "
"region runs: {command}"
msgstr ""
"Mae Robust yn rhoi ei rolau ({roles}) i {region} o'i ffurfweddiad, a "
"ddarllenir pan fydd yn cychwyn: ailgychwynnwch Robust ({restart}) cyn "
"cychwyn {slug}, neu unwaith y bydd y rhanbarth yn rhedeg: {command}"

msgctxt "notice_plan_reserves_nothing"
msgid ""
"A plan reserves nothing: the places and the ports it proposes are the free "
"ones now, chosen again when it is applied. Apply a plan before planning the "
"next one, or give the regions in one file."
msgstr ""
"Nid yw cynllun yn cadw dim: y lleoedd a'r pyrth y mae'n eu cynnig yw'r rhai "
"rhydd nawr, wedi'u dewis eto pan gaiff ei gymhwyso. Cymhwyswch gynllun cyn "
"cynllunio'r nesaf, neu rhowch y rhanbarthau mewn un ffeil."

msgctxt "notice_import_read_access"
msgid ""
"The user that runs the import cannot read {paths}: give it read access to "
"them (setfacl -R -m u:<user>:rX on the etc, var/data and var/cache of the "
"older install) before applying, nothing is written until then."
msgstr ""
"Ni all y defnyddiwr sy'n rhedeg y mewnforio ddarllen {paths}: rhowch "
"fynediad darllen iddo atynt (setfacl -R -m u:<user>:rX ar etc, var/data a "
"var/cache yr hen osodiad) cyn cymhwyso, ni ysgrifennir dim tan hynny."

msgctxt "notice_import_stop_source"
msgid ""
"The simulator that runs {regions} now keeps running until it is stopped: "
"stop it and keep it from starting again (its cron, its screen) before this "
"one starts, the database is the same."
msgstr ""
"Mae'r efelychydd sy'n rhedeg {regions} nawr yn dal i redeg nes iddo gael ei "
"atal: ataliwch ef a'i gadw rhag cychwyn eto (ei cron, ei screen) cyn i'r un "
"hwn gychwyn, yr un gronfa ddata ydyw."

msgctxt "notice_import_no_region"
msgid ""
"No region was found for {simulator} in {folder}, the folder its config "
"names: check that it is the one it reads before applying, nothing of its "
"regions would be copied."
msgstr ""
"Ni chafwyd hyd i ranbarth ar gyfer {simulator} yn {folder}, y ffolder y mae "
"ei ffurfweddiad yn ei enwi: gwiriwch mai dyna'r un y mae'n ei ddarllen cyn "
"cymhwyso, ni fyddai dim o'i ranbarthau yn cael ei gopïo."

msgctxt "notice_import_module_package"
msgid ""
"The module {module} ({key} of [{section}]) is not installed for this core: "
"the simulator would not load it. Install its package (apt install {package}) "
"and add {name} to EnabledModules of w4os.conf, or leave the setting out."
msgstr ""
"Nid yw'r modiwl {module} ({key} o [{section}]) wedi'i osod ar gyfer y craidd "
"hwn: ni fyddai'r efelychydd yn ei lwytho. Gosodwch ei becyn (apt install "
"{package}) ac ychwanegwch {name} at EnabledModules yn w4os.conf, neu gadewch "
"y gosodiad allan."

msgctxt "notice_import_module_missing"
msgid ""
"The module {module} ({key} of [{section}]) is in neither the core nor the "
"modules of this install: the simulator would not load it. Put a build of it "
"for this core in {folder} and add {name} to EnabledModules of w4os.conf, or "
"leave the setting out."
msgstr ""
"Nid yw'r modiwl {module} ({key} o [{section}]) yn y craidd nac ym modiwlau'r "
"gosodiad hwn: ni fyddai'r efelychydd yn ei lwytho. Rhowch fersiwn ohono "
"wedi'i hadeiladu ar gyfer y craidd hwn yn {folder} ac ychwanegwch {name} at "
"EnabledModules yn w4os.conf, neu gadewch y gosodiad allan."

msgctxt "notice_import_module_found"
msgid ""
"The module {module} ({key} of [{section}]) is in neither the core nor the "
"modules of this install, the older install has it in {file}: the simulator "
"would not load it. Put a build of it for this core in {folder} (a module is "
"built for a version of OpenSimulator: that file only if both cores are the "
"same version) and add {name} to EnabledModules of w4os.conf, or leave the "
"setting out."
msgstr ""
"Nid yw'r modiwl {module} ({key} o [{section}]) yn y craidd nac ym modiwlau'r "
"gosodiad hwn, mae gan yr hen osodiad ef yn {file}: ni fyddai'r efelychydd yn "
"ei lwytho. Rhowch fersiwn ohono wedi'i hadeiladu ar gyfer y craidd hwn yn "
"{folder} (mae modiwl wedi'i adeiladu ar gyfer fersiwn o OpenSimulator: y "
"ffeil honno dim ond os yw'r ddau graidd yr un fersiwn) ac ychwanegwch {name} "
"at EnabledModules yn w4os.conf, neu gadewch y gosodiad allan."

msgctxt "notice_import_enable_start"
msgid "Then: {enable}, {start}."
msgstr "Yna: {enable}, {start}."

msgctxt "notice_restart_grid"
msgid "Grid restart is required: {restart}."
msgstr "Mae angen ailgychwyn y grid: {restart}."

msgctxt "notice_restart_simulators"
msgid "Simulator(s) restart is required: {restart}."
msgstr "Mae angen ailgychwyn yr efelychydd(ion): {restart}."

msgctxt "notice_import_stop_grid"
msgid ""
"The old Robust of {grid} keeps running until it is stopped: stop it and keep "
"it from starting again (its service, its cron, its screen), its ports "
"{ports} are the ones of the grid here, its database the same."
msgstr ""
"Mae hen Robust {grid} yn dal i redeg nes iddo gael ei atal: ataliwch ef a'i "
"rwystro rhag cychwyn eto (ei wasanaeth, ei cron, ei screen); ei byrth "
"{ports} yw rhai'r grid yma, a'r un yw ei gronfa ddata."

msgctxt "notice_in_place_enable"
msgid ""
"The grid is registered in place, disabled: once its own start is stopped "
"(its service, its cron, its screen), {enable}, then {start}."
msgstr ""
"Mae'r grid wedi'i gofrestru yn ei le, wedi'i analluogi: unwaith y bydd ei "
"gychwyn ei hun wedi'i atal (ei wasanaeth, ei cron, ei screen), {enable}, yna "
"{start}."

msgctxt "notice_import_switch"
msgid ""
"Then switch: {command} (the grid and its simulators enabled and started "
"here)."
msgstr ""
"Yna newidiwch: {command} (y grid a'i efelychwyr wedi'u galluogi a'u cychwyn "
"yma)."

msgctxt "notice_restore_estate_missing"
msgid ""
"The regions {regions} have no estate in {database}, the database of the grid "
"here, which is kept as it is: they would start with none. Restore their "
"estate there, or link them to one (estate link region) before starting."
msgstr ""
"Nid oes gan y rhanbarthau {regions} ystâd yn {database}, cronfa ddata'r grid "
"yma, a gedwir fel y mae: byddent yn cychwyn heb un. Adferwch eu hystâd yno, "
"neu cysylltwch nhw ag un (estate link region) cyn cychwyn."

msgctxt "notice_restore_estate_unchecked"
msgid ""
"The estates of the regions could not be checked in {database}, the database "
"of the grid here, which is kept as it is: check that they are there before "
"starting."
msgstr ""
"Ni ellid gwirio ystadau'r rhanbarthau yn {database}, cronfa ddata'r grid "
"yma, a gedwir fel y mae: gwiriwch eu bod yno cyn cychwyn."

msgctxt "notice_restore_start"
msgid "Start {instance} once it is restored: {command}"
msgstr "Cychwynnwch {instance} unwaith y caiff ei adfer: {command}"

msgctxt "notice_mail_sent_if_known"
msgid "When an avatar has this name or this email, a mail was sent to it."
msgstr "Pan fydd gan afatar yr enw hwn neu'r ebost hwn, anfonwyd neges ato."

msgctxt "notice_mail_sent"
msgid "A mail was sent to the avatar."
msgstr "Anfonwyd neges at yr afatar."

msgctxt "notice_registered"
msgid "The avatar {name} is ready: sign in with its name and its password."
msgstr "Mae'r afatar {name} yn barod: mewngofnodwch gyda'i enw a'i gyfrinair."

msgctxt "notice_registered_confirm"
msgid ""
"A mail was sent to {email}: the account is made once the link it holds is "
"followed."
msgstr ""
"Anfonwyd neges at {email}: caiff y cyfrif ei wneud unwaith y dilynir y "
"ddolen sydd ynddi."

msgctxt "notice_registered_mail_failed"
msgid ""
"The registration is kept, but the mail to {email} could not be sent: ask for "
"it again later."
msgstr ""
"Mae'r cofrestriad wedi'i gadw, ond ni ellid anfon y neges at {email}: "
"gofynnwch amdani eto yn nes ymlaen."

msgctxt "notice_setting_file_unwritable"
msgid ""
"This server cannot write {file}, where the grid reads it: set it there by "
"hand."
msgstr ""
"Ni all y gweinydd hwn ysgrifennu {file}, lle mae'r grid yn ei ddarllen: "
"gosodwch ef yno â llaw."

msgctxt "notice_setting_file_unwritable_unkept"
msgid ""
"This server cannot write {file}, and the application keeps no settings for "
"the grid: set it there by hand."
msgstr ""
"Ni all y gweinydd hwn ysgrifennu {file}, ac nid yw'r rhaglen yn cadw "
"gosodiadau ar gyfer y grid: gosodwch ef yno â llaw."

msgctxt "notice_setting_no_files"
msgid ""
"The grid has no files on this machine: it reads this setting in its files, "
"set it there by hand."
msgstr ""
"Nid oes gan y grid ffeiliau ar y peiriant hwn: mae'n darllen y gosodiad hwn "
"yn ei ffeiliau, gosodwch ef yno â llaw."

msgctxt "notice_setting_no_files_unkept"
msgid ""
"The grid has no files on this machine, and the application keeps no settings "
"for it."
msgstr ""
"Nid oes gan y grid ffeiliau ar y peiriant hwn, ac nid yw'r rhaglen yn cadw "
"gosodiadau ar ei gyfer."

msgctxt "notice_options_no_files"
msgid ""
"The grid has no files on this machine: its options are repaired where its "
"config is kept."
msgstr ""
"Nid oes gan y grid ffeiliau ar y peiriant hwn: caiff ei opsiynau eu trwsio "
"lle cedwir ei ffurfweddiad."

msgctxt "notice_database_unsaid"
msgid "The config of the grid does not say where this database is."
msgstr "Nid yw ffurfweddiad y grid yn dweud ble mae'r gronfa ddata hon."

msgctxt "notice_database_unreachable"
msgid "The database cannot be reached."
msgstr "Ni ellir cyrraedd y gronfa ddata."

