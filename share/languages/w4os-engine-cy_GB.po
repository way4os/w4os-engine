#, php-format
msgctxt "welcome_title"
msgid "Welcome to %s"
msgstr "Croeso i %s"

msgctxt "guide_title"
msgid "Destinations guide"
msgstr "Canllaw cyrchfannau"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Creu Fy Afatar"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr "Dewiswch enw isod. Dyma sut bydd pobl yn eich gweld yn y byd rhithwir."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Creu Fy Afatar"

msgctxt "register"
msgid "Register"
msgstr "Cofrestru"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Oes gennych chi afatar yn barod?"

msgctxt "first_name"
msgid "First name"
msgstr "Enw cyntaf"

msgctxt "last_name"
msgid "Last name"
msgstr "Cyfenw"

msgctxt "first_name_help"
msgid ""
"First name must start with a letter and contain only letters and numbers"
msgstr ""
"Rhaid i'r enw cyntaf ddechrau gyda llythyren a chynnwys llythrennau a rhifau "
"yn unig"

msgctxt "last_name_help"
msgid "Last name must start with a letter and contain only letters and numbers"
msgstr ""
"Rhaid i'r cyfenw ddechrau gyda llythyren a chynnwys llythrennau a rhifau yn "
"unig"

msgctxt "email"
msgid "Email"
msgstr "Ebost"

msgctxt "password"
msgid "Password"
msgstr "Cyfrinair"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Cadarnhau cyfrinair"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"6 i 16 nod, heb ddyfynnod dwbl. Mae’r un cyfrinair yn eich mewngofnodi yma "
"ac yn y byd rhithwir."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Dewiswch y wisg gyntaf ar gyfer eich afatar."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Gallwch bob amser newid eich ymddangosiad yn y byd rhithwir."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Rwy'n cytuno i'r telerau ar dudalen %s."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Afatar %s wedi’i greu. Mewngofnodwch gyda’i enw neu eich ebost."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Almost there: click the link of the mail sent to your address to create %s."
msgstr ""
"Bron yno: cliciwch y ddolen yn yr ebost a anfonwyd i’ch cyfeiriad i greu %s."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Almost there, but the confirmation mail could not be sent. Ask for a new one "
"below to create %s, or contact the managers of the grid."
msgstr ""
"Bron yno, ond doedd dim modd anfon yr ebost cadarnhau. Gofynnwch am un "
"newydd isod i greu %s, neu cysylltwch â rheolwyr y grid."

#, php-format
msgctxt "registered_test"
msgid "Almost there. Test site, no mail: create %1$s with this link: %2$s"
msgstr "Bron yno. Safle prawf, dim ebost: crëwch %1$s gyda’r ddolen hon: %2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Cadarnhewch eich ebost"

msgctxt "confirm_text"
msgid ""
"Your avatar is created once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Caiff eich afatar ei greu cyn gynted ag y byddwch yn clicio’r ddolen yn yr "
"ebost a anfonwyd atoch. Dim byd ar ôl ychydig funudau? Edrychwch yn y "
"ffolder sbam."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is ready. You can log in now, here and in-world."
msgstr ""
"Mae eich ebost wedi’i gadarnhau, mae %s yn barod. Gallwch fewngofnodi nawr, "
"yma ac yn y byd rhithwir."

msgctxt "resend_title"
msgid "Get a new link"
msgstr "Cael dolen newydd"

msgctxt "resend_button"
msgid "Send a new link"
msgstr "Anfon dolen newydd"

msgctxt "confirm_resent"
msgid "A new link is on its way."
msgstr "Mae dolen newydd ar ei ffordd."

#, php-format
msgctxt "confirm_resent_test"
msgid "Test site, no mail: confirm with this link: %s"
msgstr "Safle prawf, dim ebost: cadarnhewch gyda’r ddolen hon: %s"

msgctxt "avatar_name"
msgid "Avatar Name"
msgstr "Enw Afatar"

msgctxt "login_title"
msgid "Login"
msgstr "Mewngofnodi"

msgctxt "log_in"
msgid "Log in"
msgstr "Mewngofnodi"

msgctxt "logout"
msgid "Logout"
msgstr "Allgofnodi"

msgctxt "login"
msgid "Avatar name or email"
msgstr "Enw afatar neu ebost"

msgctxt "sign_in_failed"
msgid "Login failed"
msgstr "Methodd y mewngofnodi"

msgctxt "forgot_title"
msgid "Forgotten password"
msgstr "Wedi anghofio'r cyfrinair"

msgctxt "forgot_text"
msgid ""
"Type the name of your avatar or your email: you will get a link to choose a "
"new password."
msgstr ""
"Teipiwch enw eich afatar neu eich ebost: byddwch yn cael dolen i ddewis "
"cyfrinair newydd."

msgctxt "forgot_button"
msgid "Send me a link"
msgstr "Anfonwch ddolen ataf"

msgctxt "forgot_sent"
msgid ""
"If an avatar has this name or this email, a link is on its way to its "
"address."
msgstr ""
"Os oes gan afatar yr enw neu’r ebost hwn, mae dolen ar ei ffordd i’w "
"gyfeiriad."

msgctxt "forgot_test"
msgid ""
"Test site, no mail: the link of a new password is not shown here, the engine "
"API gives it (send: false)."
msgstr ""
"Safle prawf, dim ebost: nid yw dolen cyfrinair newydd yn cael ei dangos yma, "
"mae API yr engine yn ei rhoi (send: false)."

msgctxt "reset_title"
msgid "Reset Password"
msgstr "Ailosod cyfrinair"

msgctxt "reset_text"
msgid "Choose the new password of your avatar."
msgstr "Dewiswch gyfrinair newydd eich afatar."

msgctxt "reset_no_token"
msgid "This page opens from the link of the mail you received."
msgstr "Mae’r dudalen hon yn agor o’r ddolen yn yr ebost a gawsoch."

msgctxt "reset_button"
msgid "Save the new password"
msgstr "Cadw’r cyfrinair newydd"

msgctxt "reset_done"
msgid "Your password is changed. You can log in with it now."
msgstr "Mae eich cyfrinair wedi newid. Gallwch fewngofnodi gydag ef nawr."

msgctxt "new_password"
msgid "New password"
msgstr "Cyfrinair newydd"

msgctxt "current_password"
msgid "Current password"
msgstr "Cyfrinair presennol"

