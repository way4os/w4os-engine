msgctxt "setting_robust_uri"
msgid "Robust URI"
msgstr "URI di Robust"

msgctxt "setting_robust_uri_help"
msgid ""
"The private address of Robust, which the simulators call for the services of "
"the grid."
msgstr ""
"L'indirizzo privato di Robust, che i simulatori chiamano per i servizi della "
"griglia."

msgctxt "setting_robust_database"
msgid "ROBUST Database"
msgstr "Database ROBUST"

msgctxt "setting_console_user"
msgid "Console User"
msgstr "Utente della console"

msgctxt "setting_console_pass"
msgid "Console Password"
msgstr "Password della console"

msgctxt "setting_console_port"
msgid "Console Port"
msgstr "Porta della console"

msgctxt "setting_console_port_help"
msgid "The port of the remote console of Robust, what drives it."
msgstr "La porta della console remota di Robust, che lo pilota."

msgctxt "setting_assets_service_uri"
msgid "Assets Service URI"
msgstr "URI del servizio asset"

msgctxt "setting_profile_service_uri"
msgid "Profile Service URI"
msgstr "URI del servizio profili"

msgctxt "uri_default_robust"
msgid "Default: the address of Robust."
msgstr "Predefinito: l'indirizzo di Robust."

msgctxt "uri_default_login"
msgid "Default: the login URI."
msgstr "Predefinito: l'URI di accesso."

msgctxt "setting_profile_page"
msgid "Profile Page"
msgstr "Pagina del profilo"

msgctxt "setting_exclude_from_stats"
msgid "Exclude from stats"
msgstr "Escludi dalle statistiche"

msgctxt "setting_exclude_from_stats_help"
msgid ""
"Accounts without email address are usually test or service accounts, created "
"from the console. Uncheck only if you have real avatars without email "
"address."
msgstr ""
"Gli account senza indirizzo email sono di solito account di test o di "
"servizio, creati dalla console. Deseleziona solo se hai avatar reali senza "
"indirizzo email."

msgctxt "exclude_models"
msgid "Models"
msgstr "Modelli"

msgctxt "exclude_nomail"
msgid "Accounts without mail address"
msgstr "Account senza indirizzo email"

msgctxt "exclude_hypergrid"
msgid "Hypergrid visitors"
msgstr "Visitatori Hypergrid"

msgctxt "setting_allow_multiple_avatars"
msgid "Allow multiple avatars"
msgstr "Consenti più avatar"

msgctxt "setting_allow_multiple_avatars_help"
msgid "Allow more than one avatar for a single email address."
msgstr "Consenti più di un avatar per un singolo indirizzo email."

msgctxt "setting_reserved_names"
msgid "Forbidden names"
msgstr "Nomi vietati"

msgctxt "setting_reserved_names_help"
msgid ""
"No new avatar may have one of them as its first or last name, nor the name "
"of the grid."
msgstr ""
"Nessun nuovo avatar può avere uno di questi come nome o cognome, né il nome "
"della griglia."

msgctxt "settings_economy"
msgid "Economy Settings"
msgstr "Impostazioni economiche"

