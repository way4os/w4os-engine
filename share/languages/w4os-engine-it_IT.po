msgid "Simulator Database"
msgstr "Database del simulatore"

msgctxt "db_default_opensim"
msgid ""
"Default: the database of the simulators of the grid, else its main database."
msgstr ""
"Predefinito: il database dei simulatori della griglia, altrimenti il suo "
"database principale."

