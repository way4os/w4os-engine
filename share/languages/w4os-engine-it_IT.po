msgstr "Un collegamento a una regione di un'altra griglia."

msgctxt "region_flag_default_hg_region_help"
msgid "Where visitors from other grids arrive, for hypergrid teleports only."
msgstr ""
"Dove arrivano i visitatori di altre griglie, solo per i teletrasporti "
"hypergrid."

