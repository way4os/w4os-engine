msgid "The friendships of the avatars."
msgstr "De vriendschappen van de avatars."

msgctxt "service_map_image"
msgid "Map tiles service"
msgstr "Kaarttegelservice"

msgctxt "service_map_image_help"
msgid "The tiles of the map of the world: the simulators add them."
msgstr "De tegels van de wereldkaart: de simulators voegen ze toe."

msgctxt "service_mute_list"
msgid "Mute list service"
msgstr "Blokkeerlijstservice"

msgctxt "service_mute_list_help"
msgid "What each avatar blocks."
msgstr "Wat elke avatar blokkeert."

msgctxt "service_bakes"
