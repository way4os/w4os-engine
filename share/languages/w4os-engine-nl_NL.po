#, php-format
msgctxt "welcome_title"
msgid "Welcome to %s"
msgstr "Welkom op %s"

msgctxt "guide_title"
msgid "Destinations guide"
msgstr "Gids voor bestemmingen"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Mijn Avatar aanmaken"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr ""
"Kies hieronder een naam. Zo zullen mensen je in de virtuele wereld zien."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Mijn Avatar aanmaken"

msgctxt "register"
msgid "Register"
msgstr "Registreren"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Heb je al een avatar?"

msgctxt "first_name"
msgid "First name"
msgstr "Voornaam"

msgctxt "last_name"
msgid "Last name"
msgstr "Achternaam"

msgctxt "first_name_help"
msgid ""
"First name must start with a letter and contain only letters and numbers"
msgstr ""
"De voornaam moet met een letter beginnen en mag alleen letters en cijfers "
"bevatten"

msgctxt "last_name_help"
msgid "Last name must start with a letter and contain only letters and numbers"
msgstr ""
"De achternaam moet met een letter beginnen en mag alleen letters en cijfers "
"bevatten"

msgctxt "email"
msgid "Email"
msgstr "E-mail"

msgctxt "password"
msgid "Password"
msgstr "Wachtwoord"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Bevestig wachtwoord"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"6 tot 16 tekens, zonder dubbele aanhalingstekens. Met hetzelfde wachtwoord "
"log je hier en in de virtuele wereld in."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Kies de eerste outfit voor je avatar."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Je kunt altijd je uiterlijk in de wereld veranderen."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Ik ga akkoord met de voorwaarden op pagina %s."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Avatar %s aangemaakt. Log in met zijn naam of je e-mail."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Almost there: click the link of the mail sent to your address to create %s."
msgstr ""
"Bijna klaar: klik op de link in de mail naar je adres om %s aan te maken."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Almost there, but the confirmation mail could not be sent. Ask for a new one "
"below to create %s, or contact the managers of the grid."
msgstr ""
"Bijna klaar, maar de bevestigingsmail kon niet worden verstuurd. Vraag "
"hieronder een nieuwe aan om %s aan te maken, of neem contact op met de "
"beheerders van het grid."

#, php-format
msgctxt "registered_test"
msgid "Almost there. Test site, no mail: create %1$s with this link: %2$s"
msgstr "Bijna klaar. Testsite, geen mail: maak %1$s aan met deze link: %2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Bevestig je e-mail"

msgctxt "confirm_text"
msgid ""
"Your avatar is created once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Je avatar wordt aangemaakt zodra je op de link klikt in de mail die we je "
"stuurden. Na een paar minuten niets? Kijk in de spammap."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is ready. You can log in now, here and in-world."
msgstr ""
"Je e-mail is bevestigd, %s is klaar. Je kunt nu inloggen, hier en in de "
"virtuele wereld."

msgctxt "resend_title"
msgid "Get a new link"
msgstr "Een nieuwe link krijgen"

msgctxt "resend_button"
msgid "Send a new link"
msgstr "Stuur een nieuwe link"

msgctxt "confirm_resent"
msgid "A new link is on its way."
msgstr "Er is een nieuwe link onderweg."

#, php-format
msgctxt "confirm_resent_test"
msgid "Test site, no mail: confirm with this link: %s"
msgstr "Testsite, geen mail: bevestig met deze link: %s"

msgctxt "avatar_name"
msgid "Avatar Name"
msgstr "Avatarnaam"

msgctxt "login_title"
msgid "Login"
msgstr "Inloggen"

msgctxt "log_in"
msgid "Log in"
msgstr "Inloggen"

msgctxt "logout"
msgid "Logout"
msgstr "Uitloggen"

msgctxt "login"
msgid "Avatar name or email"
msgstr "Avatarnaam of e-mail"

msgctxt "sign_in_failed"
msgid "Login failed"
msgstr "Inloggen mislukt"

msgctxt "forgot_title"
msgid "Forgotten password"
msgstr "Wachtwoord vergeten"

msgctxt "forgot_text"
msgid ""
"Type the name of your avatar or your email: you will get a link to choose a "
"new password."
msgstr ""
"Typ de naam van je avatar of je e-mail: je krijgt een link om een nieuw "
"wachtwoord te kiezen."

msgctxt "forgot_button"
msgid "Send me a link"
msgstr "Stuur me een link"

msgctxt "forgot_sent"
msgid ""
"If an avatar has this name or this email, a link is on its way to its "
"address."
msgstr ""
"Als een avatar deze naam of dit e-mailadres heeft, is er een link onderweg "
"naar zijn adres."

msgctxt "forgot_test"
msgid ""
"Test site, no mail: the link of a new password is not shown here, the engine "
"API gives it (send: false)."
msgstr ""
"Testsite, geen mail: de link voor een nieuw wachtwoord wordt hier niet "
"getoond, de engine-API geeft hem (send: false)."

msgctxt "reset_title"
msgid "Reset Password"
msgstr "Wachtwoord opnieuw instellen"

msgctxt "reset_text"
msgid "Choose the new password of your avatar."
msgstr "Kies het nieuwe wachtwoord van je avatar."

msgctxt "reset_no_token"
msgid "This page opens from the link of the mail you received."
msgstr "Deze pagina opent via de link in de mail die je kreeg."

msgctxt "reset_button"
msgid "Save the new password"
msgstr "Nieuw wachtwoord opslaan"

msgctxt "reset_done"
msgid "Your password is changed. You can log in with it now."
msgstr "Je wachtwoord is gewijzigd. Je kunt er nu mee inloggen."

msgctxt "new_password"
msgid "New password"
msgstr "Nieuw wachtwoord"

msgctxt "current_password"
msgid "Current password"
msgstr "Huidig wachtwoord"

