msgid "Avatar Profile"
msgstr "Avatarprofiel"

msgctxt "born"
msgid "Born"
msgstr "Geboren"

msgctxt "profile_title"
msgid "Profile"
msgstr "Profiel"

msgctxt "profile_text"
msgid ""
"What other people see of you in-world (the picture and the interests are set "
"in the viewer)."
msgstr ""
"Wat anderen in de virtuele wereld van je zien (de foto en de interesses stel "
"je in de viewer in)."

