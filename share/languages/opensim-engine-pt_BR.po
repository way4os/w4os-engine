msgid "Welcome to %s"
msgstr "Boas-vindas a %s"

msgctxt "guide_title"
msgid "Destinations guide"
msgstr "Guia de Destinos"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Criar meu avatar"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr ""
"Escolha um nome abaixo. É assim que as pessoas vão te ver no mundo virtual."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Criar meu avatar"

msgctxt "register"
msgid "Register"
msgstr "Cadastrar-se"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Já tem um avatar?"

