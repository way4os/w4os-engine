#, php-format
msgctxt "welcome_title"
msgid "Welcome to %s"
msgstr "Boas-vindas a %s"

msgctxt "guide_title"
msgid "Destinations guide"
msgstr "Guia de Destinos"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Criar meu avatar"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr ""
"Escolha um nome abaixo. É assim que as pessoas vão te ver no mundo virtual."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Criar meu avatar"

msgctxt "register"
msgid "Register"
msgstr "Cadastrar-se"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Já tem um avatar?"

msgctxt "first_name"
msgid "First name"
msgstr "Primeiro nome"

msgctxt "last_name"
msgid "Last name"
msgstr "Sobrenome"

msgctxt "first_name_help"
msgid ""
"First name must start with a letter and contain only letters and numbers"
msgstr "O nome deve começar com uma letra e conter apenas letras e números"

msgctxt "last_name_help"
msgid "Last name must start with a letter and contain only letters and numbers"
msgstr ""
"O sobrenome deve começar com uma letra e conter apenas letras e números"

msgctxt "email"
msgid "Email"
msgstr "Email"

msgctxt "password"
msgid "Password"
msgstr "Senha"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Confirmar senha"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"De 6 a 16 caracteres, sem aspas duplas. A mesma senha te conecta aqui e no "
"mundo virtual."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Escolha o primeiro traje para o seu avatar."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Você sempre pode mudar sua aparência no mundo virtual."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Eu concordo com os termos na página %s."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Avatar %s criado. Entre com o nome dele ou com seu email."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Almost there: click the link of the mail sent to your address to create %s."
msgstr ""
"Quase lá: clique no link do email enviado ao seu endereço para criar %s."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Almost there, but the confirmation mail could not be sent. Ask for a new one "
"below to create %s, or contact the managers of the grid."
msgstr ""
"Quase lá, mas o email de confirmação não pôde ser enviado. Peça um novo "
"abaixo para criar %s, ou fale com os gestores do grid."

#, php-format
msgctxt "registered_test"
msgid "Almost there. Test site, no mail: create %1$s with this link: %2$s"
msgstr "Quase lá. Site de teste, sem email: crie %1$s com este link: %2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Confirme seu email"

msgctxt "confirm_text"
msgid ""
"Your avatar is created once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Seu avatar é criado assim que você clicar no link do email que enviamos. "
"Nada depois de alguns minutos? Veja na pasta de spam."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is ready. You can log in now, here and in-world."
msgstr ""
"Seu email está confirmado, %s está pronto. Você já pode entrar, aqui e no "
"mundo virtual."

msgctxt "resend_title"
msgid "Get a new link"
msgstr "Receber um novo link"

msgctxt "resend_button"
msgid "Send a new link"
msgstr "Enviar um novo link"

msgctxt "confirm_resent"
msgid "A new link is on its way."
msgstr "Um novo link está a caminho."

#, php-format
msgctxt "confirm_resent_test"
msgid "Test site, no mail: confirm with this link: %s"
msgstr "Site de teste, sem email: confirme com este link: %s"

msgctxt "avatar_name"
msgid "Avatar Name"
msgstr "Nome do Avatar"

msgctxt "login_title"
msgid "Login"
msgstr "Entrar"

msgctxt "log_in"
msgid "Log in"
msgstr "Entrar"

msgctxt "logout"
msgid "Logout"
msgstr "Sair"

msgctxt "login"
msgid "Avatar name or email"
msgstr "Nome do avatar ou email"

msgctxt "sign_in_failed"
msgid "Login failed"
msgstr "Falha no login"

msgctxt "forgot_title"
msgid "Forgotten password"
msgstr "Esqueci minha senha"

msgctxt "forgot_text"
msgid ""
"Type the name of your avatar or your email: you will get a link to choose a "
"new password."
msgstr ""
"Digite o nome do seu avatar ou seu email: você vai receber um link para "
"escolher uma nova senha."

msgctxt "forgot_button"
msgid "Send me a link"
msgstr "Me envie um link"

msgctxt "forgot_sent"
msgid ""
"If an avatar has this name or this email, a link is on its way to its "
"address."
msgstr ""
"Se um avatar tem este nome ou este email, um link está a caminho do endereço "
"dele."

msgctxt "forgot_test"
msgid ""
"Test site, no mail: the link of a new password is not shown here, the engine "
"API gives it (send: false)."
msgstr ""
"Site de teste, sem email: o link de uma nova senha não aparece aqui, a API "
"do engine o fornece (send: false)."

msgctxt "reset_title"
msgid "Reset Password"
msgstr "Redefinir senha"

msgctxt "reset_text"
msgid "Choose the new password of your avatar."
msgstr "Escolha a nova senha do seu avatar."

msgctxt "reset_no_token"
msgid "This page opens from the link of the mail you received."
msgstr "Esta página abre pelo link do email que você recebeu."

msgctxt "reset_button"
msgid "Save the new password"
msgstr "Salvar a nova senha"

msgctxt "reset_done"
msgid "Your password is changed. You can log in with it now."
msgstr "Sua senha foi alterada. Você já pode entrar com ela."

msgctxt "new_password"
msgid "New password"
msgstr "Nova senha"

msgctxt "current_password"
msgid "Current password"
msgstr "Senha atual"

