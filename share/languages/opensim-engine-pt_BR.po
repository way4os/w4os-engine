msgid "First name"
msgstr "Primeiro nome"

msgctxt "last_name"
msgid "Last name"
msgstr "Sobrenome"

msgctxt "email"
msgid "Email"
msgstr "Email"

msgctxt "password"
msgid "Password"
msgstr "Senha"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Confirmar senha"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"De 6 a 16 caracteres, sem aspas duplas. A mesma senha te conecta aqui e no "
"mundo virtual."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Escolha o primeiro traje para o seu avatar."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Você sempre pode mudar sua aparência no mundo virtual."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Eu concordo com os termos na página %s."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Avatar %s criado. Entre com o nome dele ou com seu email."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Almost there: click the link of the mail sent to your address to create %s."
msgstr ""
"Quase lá: clique no link do email enviado ao seu endereço para criar %s."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Almost there, but the confirmation mail could not be sent. Ask for a new one "
"below to create %s, or contact the managers of the grid."
msgstr ""
"Quase lá, mas o email de confirmação não pôde ser enviado. Peça um novo "
"abaixo para criar %s, ou fale com os gestores do grid."

#, php-format
msgctxt "registered_test"
msgid "Almost there. Test site, no mail: create %1$s with this link: %2$s"
msgstr "Quase lá. Site de teste, sem email: crie %1$s com este link: %2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Confirme seu email"

msgctxt "confirm_text"
msgid ""
"Your avatar is created once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Seu avatar é criado assim que você clicar no link do email que enviamos. "
"Nada depois de alguns minutos? Veja na pasta de spam."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is ready. You can log in now, here and in-world."
msgstr ""
"Seu email está confirmado, %s está pronto. Você já pode entrar, aqui e no "
"mundo virtual."

