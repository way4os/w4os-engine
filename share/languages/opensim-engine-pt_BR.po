msgctxt "forgot_title"
msgid "Forgotten password"
msgstr "Esqueci minha senha"

msgctxt "forgot_text"
msgid ""
"Type the name of your avatar or your email: you will get a link to choose a "
"new password."
msgstr ""
"Digite o nome do seu avatar ou seu email: você vai receber um link para "
"escolher uma nova senha."

