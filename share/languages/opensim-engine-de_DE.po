#, php-format
msgctxt "welcome_title"
msgid "Welcome to %s"
msgstr "Willkommen auf %s"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Meinen Avatar erstellen"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr ""
"Wähle einen Namen unten aus. So werden dich die Leute in der Welt sehen."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Meinen Avatar erstellen"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Du hast schon einen Avatar?"

msgctxt "first_name"
msgid "First name"
msgstr "Vorname"

msgctxt "last_name"
msgid "Last name"
msgstr "Nachname"

msgctxt "email"
msgid "Email"
msgstr "E-Mail"

msgctxt "password"
msgid "Password"
msgstr "Passwort"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Passwort bestätigen"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"6 bis 16 Zeichen, ohne doppelte Anführungszeichen. Mit demselben Passwort "
"meldest du dich hier und in der Welt an."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Wähle das erste Outfit für deinen Avatar aus."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Du kannst dein Aussehen in der Welt jederzeit ändern."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Ich stimme den Bedingungen auf Seite %s zu."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Avatar %s erstellt. Melde dich mit seinem Namen oder deiner E-Mail an."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Avatar %s created. A message is on its way to your address: click the link "
"inside to confirm it, that is what activates your avatar."
msgstr ""
"Avatar %s erstellt. Eine Nachricht ist unterwegs zu deiner Adresse: Klicke "
"auf den Link darin, um sie zu bestätigen, damit wird dein Avatar aktiviert."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Avatar %s created, but the confirmation mail could not be sent. Ask for a "
"new one below, or contact the managers of the grid."
msgstr ""
"Avatar %s erstellt, aber die Bestätigungs-E-Mail konnte nicht gesendet "
"werden. Fordere unten eine neue an oder wende dich an die Verwalter des "
"Grids."

#, php-format
msgctxt "registered_test"
msgid ""
"Avatar %1$s created. Test site, no mail: confirm it with this link: %2$s"
msgstr ""
"Avatar %1$s erstellt. Testseite, keine E-Mail: Bestätige ihn mit diesem "
"Link: %2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Bestätige deine E-Mail"

msgctxt "confirm_text"
msgid ""
"Your avatar is active once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Dein Avatar ist aktiv, sobald du auf den Link in der E-Mail klickst, die wir "
"dir geschickt haben. Nach ein paar Minuten nichts da? Sieh im Spam-Ordner "
"nach."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is active. You can log in now, here and in-world."
msgstr ""
"Deine E-Mail ist bestätigt, %s ist aktiv. Du kannst dich jetzt anmelden, "
"hier und in der Welt."

msgctxt "resend_title"
msgid "Get a new link"
msgstr "Einen neuen Link erhalten"

msgctxt "resend_button"
msgid "Send a new link"
msgstr "Neuen Link senden"

msgctxt "confirm_resent"
msgid "A new link is on its way."
msgstr "Ein neuer Link ist unterwegs."

#, php-format
msgctxt "confirm_resent_test"
msgid "Test site, no mail: confirm with this link: %s"
msgstr "Testseite, keine E-Mail: Bestätige mit diesem Link: %s"

msgctxt "avatar_name"
msgid "Avatar Name"
msgstr "Avatar Name"

msgctxt "log_in"
msgid "Log in"
msgstr "Einloggen"

msgctxt "logout"
msgid "Logout"
msgstr "Abmelden"

msgctxt "login"
msgid "Avatar name or email"
msgstr "Avatarname oder E-Mail"

msgctxt "forgot_title"
msgid "Lost Password"
msgstr "Verlorenes Passwort"

msgctxt "forgot_text"
msgid ""
"Type the name of your avatar or your email: you will get a link to choose a "
"new password."
msgstr ""
"Gib den Namen deines Avatars oder deine E-Mail ein: Du erhältst einen Link, "
"um ein neues Passwort zu wählen."

msgctxt "forgot_button"
msgid "Send me a link"
msgstr "Link senden"

msgctxt "forgot_sent"
msgid ""
"If an avatar has this name or this email, a link is on its way to its "
"address."
msgstr ""
"Wenn ein Avatar diesen Namen oder diese E-Mail hat, ist ein Link zu seiner "
"Adresse unterwegs."

msgctxt "forgot_test"
msgid ""
"Test site, no mail: the link of a new password is not shown here, the engine "
"API gives it (send: false)."
msgstr ""
"Testseite, keine E-Mail: Der Link für ein neues Passwort wird hier nicht "
"gezeigt, die Engine-API liefert ihn (send: false)."

msgctxt "reset_title"
msgid "Reset Password"
msgstr "Passwort zurücksetzen"

msgctxt "reset_text"
msgid "Choose the new password of your avatar."
msgstr "Wähle das neue Passwort deines Avatars."

msgctxt "reset_no_token"
msgid "This page opens from the link of the mail you received."
msgstr "Diese Seite öffnet sich über den Link aus der erhaltenen E-Mail."

msgctxt "reset_button"
msgid "Save the new password"
msgstr "Neues Passwort speichern"

msgctxt "reset_done"
msgid "Your password is changed. You can log in with it now."
msgstr "Dein Passwort ist geändert. Du kannst dich jetzt damit anmelden."

msgctxt "new_password"
msgid "New password"
msgstr "Neues Passwort"

msgctxt "current_password"
msgid "Current password"
msgstr "Aktuelles Passwort"

msgctxt "account_title"
msgid "Avatar Profile"
msgstr "Avatar-Profil"

msgctxt "born"
msgid "Born"
msgstr "Geboren"

msgctxt "profile_title"
msgid "Profile"
msgstr "Profil"

msgctxt "profile_text"
msgid ""
"What other people see of you in-world (the picture and the interests are set "
"in the viewer)."
msgstr ""
"Was andere in der Welt von dir sehen (Bild und Interessen werden im Viewer "
"eingestellt)."

msgctxt "about"
msgid "About"
msgstr "Über"

msgctxt "wants"
msgid "Wants to"
msgstr "Möchte"

msgctxt "skills"
msgid "Skills"
msgstr "Fertigkeiten"

msgctxt "languages"
msgid "Languages"
msgstr "Sprachen"

msgctxt "first_life"
msgid "Real Life"
msgstr "Reales Leben"

msgctxt "profile_url"
msgid "Web page"
msgstr "Webseite"

msgctxt "save_button"
msgid "Save"
msgstr "Speichern"

msgctxt "profile_saved"
msgid "Your profile is saved."
msgstr "Dein Profil ist gespeichert."

msgctxt "password_title"
msgid "Password"
msgstr "Passwort"

msgctxt "password_button"
msgid "Change the password"
msgstr "Passwort ändern"

msgctxt "password_saved"
msgid "Your password is changed."
msgstr "Dein Passwort ist geändert."

#, php-format
msgctxt "email_pending"
msgid ""
"Your profile is saved. A link is on its way to %s: click it to make it your "
"email."
msgstr ""
"Dein Profil ist gespeichert. Ein Link ist unterwegs zu %s: Klicke darauf, "
"damit sie deine E-Mail wird."

#, php-format
msgctxt "email_pending_test"
msgid ""
"Your profile is saved. Test site, no mail: confirm %1$s with this link: %2$s"
msgstr ""
"Dein Profil ist gespeichert. Testseite, keine E-Mail: Bestätige %1$s mit "
"diesem Link: %2$s"

#, php-format
msgctxt "email_changed"
msgid "Your email is now %s."
msgstr "Deine E-Mail ist jetzt %s."

msgctxt "manage_title"
msgid "Avatars"
msgstr "Avatare"

msgctxt "search_avatars"
msgid "Name or email"
msgstr "Name oder E-Mail"

msgctxt "search"
msgid "Search"
msgstr "Suchen"

msgctxt "no_avatars"
msgid "No result"
msgstr "Kein Ergebnis"

#, php-format
msgctxt "avatars_count"
msgid "%s avatars"
msgstr "%s Avatare"

msgctxt "status"
msgid "Status"
msgstr "Status"

msgctxt "last_seen"
msgid "Last Seen"
msgstr "Zuletzt gesehen"

msgctxt "created"
msgid "Created"
msgstr "Erstellt"

msgctxt "actions"
msgid "Actions"
msgstr "Aktionen"

msgctxt "god"
msgid "God"
msgstr "Gott"

msgctxt "online"
msgid "Online"
msgstr "Online"

msgctxt "status_active"
msgid "Active"
msgstr "Aktiv"

msgctxt "status_disabled"
msgid "Disabled"
msgstr ""

msgctxt "status_pending"
msgid "Waiting for email confirmation"
msgstr ""

