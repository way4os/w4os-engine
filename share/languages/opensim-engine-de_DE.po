msgstr "Nachname"

msgctxt "first_name_help"
msgid ""
"First name must start with a letter and contain only letters and numbers"
msgstr ""
"Der Vorname muss mit einem Buchstaben beginnen und darf nur Buchstaben und "
"Ziffern enthalten"

msgctxt "last_name_help"
msgid "Last name must start with a letter and contain only letters and numbers"
msgstr ""
"Der Nachname muss mit einem Buchstaben beginnen und darf nur Buchstaben und "
