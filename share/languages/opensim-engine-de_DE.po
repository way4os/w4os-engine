msgctxt "error_terms"
msgid "You must agree to the terms on page %s."
msgstr "Du musst den Bedingungen auf Seite %s zustimmen."

msgctxt "error_current_password"
msgid "The current password is wrong."
msgstr "Das aktuelle Passwort ist falsch."

msgctxt "error_forbidden"
msgid "This is not allowed."
msgstr "Das ist nicht erlaubt."

msgctxt "error_nonce"
msgid "This page has expired, please try again."
msgstr "Diese Seite ist abgelaufen, bitte versuche es noch einmal."

#, php-format
msgctxt "error_too_many_registrations"
msgid "Too many registrations from this address. Try again in %s minutes."
msgstr ""
"Zu viele Registrierungen von dieser Adresse. Versuche es in %s Minuten "
"erneut."

msgctxt "error_not_found"
msgid "Not found"
msgstr "Nicht gefunden"

msgctxt "error_not_found_grid"
msgid "Grid not found"
msgstr "Grid nicht gefunden"

msgctxt "error_not_found_avatar"
msgid "Avatar not found"
msgstr "Avatar nicht gefunden"

msgctxt "error_not_found_avatar_model"
msgid "Avatar model not found"
msgstr "Avatar-Modell nicht gefunden"

msgctxt "error_not_found_region"
msgid "Region not found"
msgstr "Region nicht gefunden"

msgctxt "error_not_found_simulator"
msgid "Simulator not found"
msgstr "Simulator nicht gefunden"

msgctxt "error_not_found_estate"
msgid "Estate not found"
msgstr "Estate nicht gefunden"

msgctxt "error_not_found_parcel"
msgid "Parcel not found"
msgstr "Parzelle nicht gefunden"

msgctxt "error_not_found_asset"
msgid "Asset not found"
msgstr "Asset nicht gefunden"

msgctxt "error_not_found_post"
msgid "Post not found"
msgstr "Beitrag nicht gefunden"

msgctxt "error_not_found_destination"
msgid "Destination not found"
msgstr "Ziel nicht gefunden"

msgctxt "error_invalid_request"
msgid "This cannot be done."
msgstr "Das ist nicht möglich."

msgctxt "error_invalid_document"
msgid "This cannot be done."
msgstr "Das ist nicht möglich."

msgctxt "error_type_conflict"
msgid "This cannot be done."
msgstr "Das ist nicht möglich."

msgctxt "error_unauthorized"
msgid "The grid cannot be reached right now. Please try again later."
msgstr ""
"Das Grid ist gerade nicht erreichbar. Bitte versuche es später noch einmal."

msgctxt "error_method_not_allowed"
msgid "This cannot be done."
msgstr "Das ist nicht möglich."

msgctxt "error_channel_unavailable"
msgid "The grid cannot be reached right now. Please try again later."
msgstr ""
"Das Grid ist gerade nicht erreichbar. Bitte versuche es später noch einmal."

msgctxt "error_instance_failed"
msgid "The grid cannot be reached right now. Please try again later."
msgstr ""
"Das Grid ist gerade nicht erreichbar. Bitte versuche es später noch einmal."

msgctxt "error_internal_error"
msgid "The grid cannot be reached right now. Please try again later."
msgstr ""
"Das Grid ist gerade nicht erreichbar. Bitte versuche es später noch einmal."

msgctxt "error_sign_in_refused"
msgid "The name or the password is wrong."
msgstr "Der Name oder das Passwort ist falsch."

msgctxt "error_account_disabled"
msgid "This avatar is disabled. Contact the managers of the grid."
msgstr "Dieser Avatar ist deaktiviert. Wende dich an die Verwalter des Grids."

msgctxt "error_account_banned"
msgid "This avatar is banned."
msgstr "Dieser Avatar ist gebannt."

msgctxt "error_post_invalid"
msgid "A post has 1 to 1000 characters."
msgstr "Ein Beitrag hat 1 bis 1000 Zeichen."

msgctxt "error_email_unconfirmed"
msgid ""
"This avatar is not active yet: confirm your email with the link of the mail "
"we sent you."
msgstr ""
"Dieser Avatar ist noch nicht aktiv: Bestätige deine E-Mail mit dem Link, den "
"wir dir geschickt haben."

msgctxt "error_name_invalid"
msgid ""
"The first and the last name are made of letters, digits and hyphens, without "
"accents."
msgstr ""
"Vor- und Nachname bestehen aus Buchstaben, Ziffern und Bindestrichen, ohne "
"Akzente."

msgctxt "error_name_reserved"
msgid "This name is reserved, please choose another one."
msgstr "Dieser Name ist reserviert, bitte wähle einen anderen."

msgctxt "error_name_taken"
msgid "An avatar already has this name, please choose another one."
msgstr "Ein Avatar hat schon diesen Namen, bitte wähle einen anderen."

msgctxt "error_password_required"
msgid "Please fill in every field."
msgstr "Bitte fülle alle Felder aus."

msgctxt "error_password_invalid"
msgid "The password must have 6 to 16 characters, without double quote."
msgstr ""
"Das Passwort muss 6 bis 16 Zeichen haben, ohne doppelte Anführungszeichen."

msgctxt "error_email_invalid"
msgid "This email address is not valid."
msgstr "Diese E-Mail-Adresse ist nicht gültig."

msgctxt "error_email_required"
msgid "This avatar has no email address."
msgstr "Dieser Avatar hat keine E-Mail-Adresse."

msgctxt "error_model_unknown"
msgid "This outfit is not available, please choose another one."
msgstr "Dieses Outfit ist nicht verfügbar, bitte wähle ein anderes."

msgctxt "error_link_invalid"
msgid "This cannot be done."
msgstr "Das ist nicht möglich."

msgctxt "error_field_unknown"
msgid "This cannot be done."
msgstr "Das ist nicht möglich."

msgctxt "error_field_read_only"
msgid ""
"The name, the place and the size of a region are changed in its file, by its "
"operator."
msgstr ""
"Name, Ort und Größe einer Region werden in ihrer Datei geändert, von ihrem "
"Betreiber."

msgctxt "error_flag_unknown"
msgid "This flag does not exist."
msgstr "Diese Markierung gibt es nicht."

msgctxt "error_owner_unknown"
msgid "This avatar does not exist."
msgstr "Diesen Avatar gibt es nicht."

msgctxt "error_config_not_writable"
msgid ""
"This cannot be changed from here: the files of the grid belong to its server."
msgstr ""
"Das lässt sich von hier aus nicht ändern: die Dateien des Grids gehören "
"seinem Server."

msgctxt "error_instance_user_required"
msgid ""
"This cannot be done from here: the simulators are started and stopped on "
"their server."
msgstr ""
"Das ist von hier aus nicht möglich: die Simulatoren werden auf ihrem Server "
"gestartet und gestoppt."

msgctxt "error_restore_conflict"
msgid "This backup holds what this server has already: nothing was replaced."
msgstr ""
"Diese Sicherung enthält, was dieser Server schon hat: nichts wurde ersetzt."

msgctxt "error_source_not_readable"
msgid ""
"Some files of the older install cannot be read by the server: give it read "
"access to them first."
msgstr ""
"Einige Dateien der alten Installation kann der Server nicht lesen: gib ihm "
"zuerst Lesezugriff darauf."

msgctxt "error_estate_shared"
msgid ""
"The owner of this region is the owner of its estate, which has other "
"regions: change the owner of the estate."
msgstr ""
"Der Eigentümer dieser Region ist der ihres Estates, das weitere Regionen "
"hat: ändere den Eigentümer des Estates."

msgctxt "error_filter_unknown"
msgid "This list cannot be filtered this way."
msgstr "Diese Liste lässt sich so nicht filtern."

msgctxt "error_filter_value_unknown"
msgid "This list cannot be filtered this way."
msgstr "Diese Liste lässt sich so nicht filtern."

msgctxt "error_sort_unknown"
msgid "This list cannot be sorted this way."
msgstr "Diese Liste lässt sich so nicht sortieren."

msgctxt "error_role_unknown"
msgid "This role does not exist."
msgstr "Diese Rolle gibt es nicht."

msgctxt "error_role_level_conflict"
msgid "The level does not match the role."
msgstr "Die Stufe passt nicht zur Rolle."

msgctxt "error_token_refused"
msgid ""
"This link does not work: it has expired or it was already used. Ask for a "
"new one."
msgstr ""
"Dieser Link funktioniert nicht: Er ist abgelaufen oder wurde schon benutzt. "
"Fordere einen neuen an."

msgctxt "error_no_confirmation_pending"
msgid "This avatar does not wait for the confirmation of its email."
msgstr "Dieser Avatar wartet nicht auf die Bestätigung seiner E-Mail."

msgctxt "error_mail_failed"
msgid "The mail could not be sent. Please try again later."
msgstr ""
"Die E-Mail konnte nicht gesendet werden. Bitte versuche es später noch "
"einmal."

msgctxt "notice_robust_restart_roles"
msgid ""
"Robust reads {key} when it starts: restart Robust ({restart}) so it gives "
"the region these roles when it registers again."
msgstr ""
"Robust liest {key} beim Start: starte Robust neu ({restart}), damit es der "
"Region diese Rollen gibt, wenn sie sich wieder anmeldet."

msgctxt "notice_robust_config_line"
msgid ""
"{file} cannot be written by this process: set {line} in its [{section}], "
"then restart Robust ({restart})."
msgstr ""
"{file} kann von diesem Prozess nicht geschrieben werden: setze {line} in "
"[{section}], dann starte Robust neu ({restart})."

msgctxt "notice_robust_config_remove"
msgid ""
"{file} cannot be written by this process: remove {key} from its [{section}], "
"then restart Robust ({restart})."
msgstr ""
"{file} kann von diesem Prozess nicht geschrieben werden: entferne {key} aus "
"[{section}], dann starte Robust neu ({restart})."

msgctxt "notice_robust_config_elsewhere"
msgid ""
"The config of Robust is not on this machine: set {line} in its [{section}], "
"so the region keeps its roles when it registers again."
msgstr ""
"Die Konfiguration von Robust liegt nicht auf diesem Rechner: setze dort "
"{line} in [{section}], damit die Region ihre Rollen behält, wenn sie sich "
"wieder anmeldet."

msgctxt "notice_start_simulator"
msgid "Start the simulator {slug}: {command}"
msgstr "Starte den Simulator {slug}: {command}"

msgctxt "notice_start_simulator_regions"
msgid "The simulator {slug} loads its new regions when it starts: {command}"
msgstr "Der Simulator {slug} lädt seine neuen Regionen beim Start: {command}"

msgctxt "notice_region_roles_later"
msgid ""
"Robust gives {region} its roles ({roles}) from its config, read when it "
"starts: restart Robust ({restart}) before starting {slug}, or once the "
"region runs: {command}"
msgstr ""
"Robust gibt {region} seine Rollen ({roles}) aus seiner Konfiguration, die es "
"beim Start liest: starte Robust neu ({restart}), bevor du {slug} startest, "
"oder sobald die Region läuft: {command}"

msgctxt "notice_plan_reserves_nothing"
msgid ""
"A plan reserves nothing: the places and the ports it proposes are the free "
"ones now, chosen again when it is applied. Apply a plan before planning the "
"next one, or give the regions in one file."
msgstr ""
"Ein Plan reserviert nichts: die Orte und Ports, die er vorschlägt, sind die "
"jetzt freien und werden beim Anwenden neu gewählt. Wende einen Plan an, "
"bevor du den nächsten planst, oder gib die Regionen in einer Datei an."

msgctxt "notice_import_read_access"
msgid ""
"The user that runs the import cannot read {paths}: give it read access to "
"them (setfacl -R -m u:<user>:rX on the etc, var/data and var/cache of the "
"older install) before applying, nothing is written until then."
msgstr ""
"Der Benutzer, der den Import ausführt, kann {paths} nicht lesen: gib ihm vor "
"dem Anwenden Lesezugriff darauf (setfacl -R -m u:<user>:rX auf etc, var/data "
"und var/cache der alten Installation), bis dahin wird nichts geschrieben."

msgctxt "notice_import_stop_source"
msgid ""
"The simulator that runs {regions} now keeps running until it is stopped: "
"stop it and keep it from starting again (its cron, its screen) before this "
"one starts, the database is the same."
msgstr ""
"Der Simulator, der jetzt {regions} betreibt, läuft weiter, bis er gestoppt "
"wird: stoppe ihn und verhindere seinen Neustart (Cron, Screen), bevor dieser "
"startet, die Datenbank ist dieselbe."

msgctxt "notice_import_no_region"
msgid ""
"No region was found for {simulator} in {folder}, the folder its config "
"names: check that it is the one it reads before applying, nothing of its "
"regions would be copied."
msgstr ""
"Für {simulator} wurde in {folder}, dem Ordner, den seine Konfiguration "
"nennt, keine Region gefunden: prüfe vor dem Anwenden, dass er diesen liest, "
"sonst wird keine seiner Regionen kopiert."

msgctxt "notice_import_module_package"
msgid ""
"The module {module} ({key} of [{section}]) is not installed for this core: "
"the simulator would not load it. Install its package (apt install {package}) "
"and add {name} to EnabledModules of opensim.conf, or leave the setting out."
msgstr ""
"Das Modul {module} ({key} von [{section}]) ist für diesen Kern nicht "
"installiert: Der Simulator würde es nicht laden. Installiere sein Paket (apt "
"install {package}) und füge {name} zu EnabledModules in opensim.conf hinzu, "
"oder lass die Einstellung weg."

msgctxt "notice_import_module_missing"
msgid ""
"The module {module} ({key} of [{section}]) is in neither the core nor the "
"modules of this install: the simulator would not load it. Put a build of it "
"for this core in {folder} and add {name} to EnabledModules of opensim.conf, "
"or leave the setting out."
msgstr ""
"Das Modul {module} ({key} von [{section}]) ist weder im Kern noch in den "
"Modulen dieser Installation: Der Simulator würde es nicht laden. Lege einen "
"Build davon für diesen Kern in {folder} ab und füge {name} zu EnabledModules "
"in opensim.conf hinzu, oder lass die Einstellung weg."

msgctxt "notice_import_module_found"
msgid ""
"The module {module} ({key} of [{section}]) is in neither the core nor the "
"modules of this install, the older install has it in {file}: the simulator "
"would not load it. Put a build of it for this core in {folder} (a module is "
"built for a version of OpenSimulator: that file only if both cores are the "
"same version) and add {name} to EnabledModules of opensim.conf, or leave the "
"setting out."
msgstr ""
"Das Modul {module} ({key} von [{section}]) ist weder im Kern noch in den "
"Modulen dieser Installation, die ältere Installation hat es in {file}: Der "
"Simulator würde es nicht laden. Lege einen Build davon für diesen Kern in "
"{folder} ab (ein Modul wird für eine Version von OpenSimulator gebaut: diese "
"Datei nur, wenn beide Kerne dieselbe Version haben) und füge {name} zu "
"EnabledModules in opensim.conf hinzu, oder lass die Einstellung weg."

msgctxt "notice_import_enable_start"
msgid "Then: {enable}, {start}."
msgstr "Dann: {enable}, {start}."

msgctxt "notice_restore_estate_missing"
msgid ""
"The regions {regions} have no estate in {database}, the database of the grid "
"here, which is kept as it is: they would start with none. Restore their "
"estate there, or link them to one (estate link region) before starting."
msgstr ""
"Die Regionen {regions} haben kein Estate in {database}, der Datenbank des "
"Grids hier, die so bleibt, wie sie ist: sie würden ohne starten. Stelle ihr "
"Estate dort wieder her oder verknüpfe sie vor dem Start mit einem (estate "
"link region)."

msgctxt "notice_restore_estate_unchecked"
msgid ""
"The estates of the regions could not be checked in {database}, the database "
"of the grid here, which is kept as it is: check that they are there before "
"starting."
msgstr ""
"Die Estates der Regionen konnten in {database}, der Datenbank des Grids "
"hier, die so bleibt, wie sie ist, nicht geprüft werden: prüfe vor dem Start, "
"dass sie da sind."

msgctxt "notice_restore_start"
msgid "Start {instance} once it is restored: {command}"
msgstr "Starte {instance}, sobald es wiederhergestellt ist: {command}"

msgctxt "notice_mail_sent_if_known"
msgid "When an avatar has this name or this email, a mail was sent to it."
msgstr ""
"Wenn ein Avatar diesen Namen oder diese E-Mail hat, wurde ihm eine Mail "
"geschickt."

msgctxt "notice_mail_sent"
msgid "A mail was sent to the avatar."
msgstr "Dem Avatar wurde eine Mail geschickt."

msgctxt "notice_registered"
msgid "The avatar {name} is ready: sign in with its name and its password."
msgstr ""
"Der Avatar {name} ist bereit: melde dich mit seinem Namen und seinem "
"Passwort an."

msgctxt "notice_registered_confirm"
msgid ""
"A mail was sent to {email}: the account is made once the link it holds is "
"followed."
msgstr ""
"Eine Mail wurde an {email} geschickt: das Konto entsteht, sobald dem Link "
"darin gefolgt wird."

msgctxt "notice_registered_mail_failed"
msgid ""
"The registration is kept, but the mail to {email} could not be sent: ask for "
"it again later."
msgstr ""
"Die Registrierung bleibt bestehen, aber die Mail an {email} konnte nicht "
"gesendet werden: fordere sie später erneut an."

