#, php-format
msgctxt "welcome_title"
msgid "Welcome to %s"
msgstr "Benvenuto su %s"

msgctxt "guide_title"
msgid "Destinations guide"
msgstr "Guida delle destinazioni"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Crea il mio avatar"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr ""
"Scegli un nome qui sotto. È così che le persone ti vedranno nel mondo "
"virtuale."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Crea il mio avatar"

msgctxt "register"
msgid "Register"
msgstr "Registrati"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Hai già un avatar?"

msgctxt "first_name"
msgid "First name"
msgstr "Nome"

msgctxt "last_name"
msgid "Last name"
msgstr "Cognome"

msgctxt "first_name_help"
msgid ""
"First name must start with a letter and contain only letters and numbers"
msgstr ""
"Il nome deve iniziare con una lettera e contenere solo lettere e numeri"

msgctxt "last_name_help"
msgid "Last name must start with a letter and contain only letters and numbers"
msgstr ""
"Il cognome deve iniziare con una lettera e contenere solo lettere e numeri"

msgctxt "email"
msgid "Email"
msgstr "Email"

msgctxt "password"
msgid "Password"
msgstr "Password"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Conferma password"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"Da 6 a 16 caratteri, senza virgolette doppie. La stessa password ti fa "
"accedere qui e nel mondo virtuale."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Scegli il primo outfit per il tuo avatar."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Puoi sempre cambiare il tuo aspetto nel mondo virtuale."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Accetto i termini nella pagina %s."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Avatar %s creato. Accedi con il suo nome o la tua email."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Almost there: click the link of the mail sent to your address to create %s."
msgstr ""
"Ci siamo quasi: clicca sul link dell’email inviata al tuo indirizzo per "
"creare %s."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Almost there, but the confirmation mail could not be sent. Ask for a new one "
"below to create %s, or contact the managers of the grid."
msgstr ""
"Ci siamo quasi, ma l’email di conferma non è potuta partire. Chiedine una "
"nuova qui sotto per creare %s, o contatta i gestori della griglia."

#, php-format
msgctxt "registered_test"
msgid "Almost there. Test site, no mail: create %1$s with this link: %2$s"
msgstr ""
"Ci siamo quasi. Sito di prova, nessuna email: crea %1$s con questo link: %2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Conferma la tua email"

msgctxt "confirm_text"
msgid ""
"Your avatar is created once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Il tuo avatar viene creato appena clicchi sul link dell’email che ti abbiamo "
"inviato. Niente dopo qualche minuto? Guarda nella cartella spam."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is ready. You can log in now, here and in-world."
msgstr ""
"La tua email è confermata, %s è pronto. Ora puoi accedere, qui e nel mondo "
"virtuale."

msgctxt "resend_title"
msgid "Get a new link"
msgstr "Ricevere un nuovo link"

msgctxt "resend_button"
msgid "Send a new link"
msgstr "Invia un nuovo link"

msgctxt "confirm_resent"
msgid "A new link is on its way."
msgstr "Un nuovo link sta arrivando."

#, php-format
msgctxt "confirm_resent_test"
msgid "Test site, no mail: confirm with this link: %s"
msgstr "Sito di prova, nessuna email: conferma con questo link: %s"

msgctxt "avatar_name"
msgid "Avatar Name"
msgstr "Nome dell'avatar"

msgctxt "login_title"
msgid "Login"
msgstr "Accesso"

msgctxt "log_in"
msgid "Log in"
msgstr "Accedi"

msgctxt "logout"
msgid "Logout"
msgstr "Disconnetti"

msgctxt "login"
msgid "Avatar name or email"
msgstr "Nome dell’avatar o email"

msgctxt "sign_in_failed"
msgid "Login failed"
msgstr "Accesso non riuscito"

msgctxt "forgot_title"
msgid "Forgotten password"
msgstr "Password dimenticata"

msgctxt "forgot_text"
msgid ""
"Type the name of your avatar or your email: you will get a link to choose a "
"new password."
msgstr ""
"Scrivi il nome del tuo avatar o la tua email: riceverai un link per "
"scegliere una nuova password."

msgctxt "forgot_button"
msgid "Send me a link"
msgstr "Inviami un link"

msgctxt "forgot_sent"
msgid ""
"If an avatar has this name or this email, a link is on its way to its "
"address."
msgstr ""
"Se un avatar ha questo nome o questa email, un link sta arrivando al suo "
"indirizzo."

msgctxt "forgot_test"
msgid ""
"Test site, no mail: the link of a new password is not shown here, the engine "
"API gives it (send: false)."
msgstr ""
"Sito di prova, nessuna email: il link di una nuova password non è mostrato "
"qui, lo dà l’API dell’engine (send: false)."

msgctxt "reset_title"
msgid "Reset Password"
msgstr "Resetta Password"

msgctxt "reset_text"
msgid "Choose the new password of your avatar."
msgstr "Scegli la nuova password del tuo avatar."

msgctxt "reset_no_token"
msgid "This page opens from the link of the mail you received."
msgstr "Questa pagina si apre dal link dell’email che hai ricevuto."

msgctxt "reset_button"
msgid "Save the new password"
msgstr "Salva la nuova password"

msgctxt "reset_done"
msgid "Your password is changed. You can log in with it now."
msgstr "La tua password è cambiata. Ora puoi accedere con essa."

msgctxt "new_password"
msgid "New password"
msgstr "Nuova password"

msgctxt "current_password"
msgid "Current password"
msgstr "Password attuale"

