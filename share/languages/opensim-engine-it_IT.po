msgid "Welcome to %s"
msgstr "Benvenuto su %s"

msgctxt "guide_title"
msgid "Destinations guide"
msgstr "Guida delle destinazioni"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Crea il mio avatar"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr ""
"Scegli un nome qui sotto. È così che le persone ti vedranno nel mondo "
"virtuale."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Crea il mio avatar"

msgctxt "register"
msgid "Register"
msgstr "Registrati"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Hai già un avatar?"

msgctxt "first_name"
msgid "First name"
msgstr "Nome"

msgctxt "last_name"
msgid "Last name"
msgstr "Cognome"

msgctxt "email"
msgid "Email"
msgstr "Email"

msgctxt "password"
msgid "Password"
msgstr "Password"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Conferma password"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"Da 6 a 16 caratteri, senza virgolette doppie. La stessa password ti fa "
"accedere qui e nel mondo virtuale."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Scegli il primo outfit per il tuo avatar."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Puoi sempre cambiare il tuo aspetto nel mondo virtuale."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Accetto i termini nella pagina %s."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Avatar %s creato. Accedi con il suo nome o la tua email."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Almost there: click the link of the mail sent to your address to create %s."
msgstr ""
"Ci siamo quasi: clicca sul link dell’email inviata al tuo indirizzo per "
"creare %s."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Almost there, but the confirmation mail could not be sent. Ask for a new one "
"below to create %s, or contact the managers of the grid."
msgstr ""
"Ci siamo quasi, ma l’email di conferma non è potuta partire. Chiedine una "
"nuova qui sotto per creare %s, o contatta i gestori della griglia."

#, php-format
msgctxt "registered_test"
msgid "Almost there. Test site, no mail: create %1$s with this link: %2$s"
msgstr ""
"Ci siamo quasi. Sito di prova, nessuna email: crea %1$s con questo link: %2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Conferma la tua email"

msgctxt "confirm_text"
msgid ""
"Your avatar is created once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Il tuo avatar viene creato appena clicchi sul link dell’email che ti abbiamo "
"inviato. Niente dopo qualche minuto? Guarda nella cartella spam."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is ready. You can log in now, here and in-world."
msgstr ""
"La tua email è confermata, %s è pronto. Ora puoi accedere, qui e nel mondo "
"virtuale."

msgctxt "resend_title"
msgid "Get a new link"
msgstr "Ricevere un nuovo link"

msgctxt "resend_button"
msgid "Send a new link"
msgstr "Invia un nuovo link"

msgctxt "confirm_resent"
msgid "A new link is on its way."
msgstr "Un nuovo link sta arrivando."

#, php-format
