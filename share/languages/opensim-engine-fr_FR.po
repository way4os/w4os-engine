msgstr "Service des amis"

msgctxt "service_friends_help"
msgid "The friendships of the avatars."
msgstr "Les amitiés des avatars."

msgctxt "service_map_image"
msgid "Map tiles service"
msgstr "Service des tuiles de la carte"

msgctxt "service_map_image_help"
msgid "The tiles of the map of the world: the simulators add them."
msgstr "Les tuiles de la carte du monde : les simulateurs les ajoutent."

msgctxt "service_mute_list"
msgid "Mute list service"
msgstr "Service des listes de blocage"

msgctxt "service_mute_list_help"
msgid "What each avatar blocks."
msgstr "Ce que chaque avatar bloque."

msgctxt "service_bakes"
msgid "Baked textures service"
msgstr "Service des textures cuites"

msgctxt "service_bakes_help"
msgid "The baked textures of the avatars, shared between the simulators."
msgstr "Les textures cuites des avatars, partagées entre les simulateurs."

msgctxt "service_groups"
