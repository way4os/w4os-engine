#, php-format
msgctxt "welcome_title"
msgid "Welcome to %s"
msgstr "Bienvenue sur %s"

msgctxt "register_title"
msgid "Create My Avatar"
msgstr "Créer mon avatar"

msgctxt "register_text"
msgid "Choose a name below. This is how people will see you in-world."
msgstr ""
"Choisissez un nom ci-dessous. C'est ainsi que les gens vous verront dans le "
"monde virtuel."

msgctxt "register_button"
msgid "Create My Avatar"
msgstr "Créer mon avatar"

msgctxt "have_avatar"
msgid "Already have an avatar?"
msgstr "Vous avez déjà un avatar ?"

msgctxt "first_name"
msgid "First name"
msgstr "Prénom"

msgctxt "last_name"
msgid "Last name"
msgstr "Nom de famille"

msgctxt "email"
msgid "Email"
msgstr "E-mail"

msgctxt "password"
msgid "Password"
msgstr "Mot de passe"

msgctxt "password_confirm"
msgid "Confirm password"
msgstr "Confirmez le mot de passe"

msgctxt "password_help"
msgid ""
"6 to 16 characters, without double quote. The same password logs you in here "
"and in-world."
msgstr ""
"De 6 à 16 caractères, sans guillemet double. Le même mot de passe vous "
"connecte ici et dans le monde virtuel."

msgctxt "model"
msgid "Choose the first outfit for your avatar."
msgstr "Choisissez le premier ensemble pour votre avatar."

msgctxt "model_help"
msgid "You can always change your appearance in-world."
msgstr "Vous pourrez toujours changer d’apparence dans le monde virtuel."

#, php-format
msgctxt "terms_agree"
msgid "I agree to the terms on page %s."
msgstr "Je suis d'accord avec les conditions de la page %s."

#, php-format
msgctxt "registered"
msgid "Avatar %s created successfully. Log in with its name or your email."
msgstr "Avatar %s créé. Connectez-vous avec son nom ou votre e-mail."

#, php-format
msgctxt "registered_confirm"
msgid ""
"Avatar %s created. A message is on its way to your address: click the link "
"inside to confirm it, that is what activates your avatar."
msgstr ""
"Avatar %s créé. Un message part vers votre adresse : cliquez sur le lien "
"qu’il contient pour la confirmer, c’est ce qui active votre avatar."

#, php-format
msgctxt "registered_not_sent"
msgid ""
"Avatar %s created, but the confirmation mail could not be sent. Ask for a "
"new one below, or contact the managers of the grid."
msgstr ""
"Avatar %s créé, mais le message de confirmation n’a pas pu partir. Demandez-"
"en un nouveau ci-dessous, ou contactez les gestionnaires de la grille."

#, php-format
msgctxt "registered_test"
msgid ""
"Avatar %1$s created. Test site, no mail: confirm it with this link: %2$s"
msgstr ""
"Avatar %1$s créé. Site de test, pas de mail : confirmez-le avec ce lien : "
"%2$s"

msgctxt "confirm_title"
msgid "Confirm your email"
msgstr "Confirmez votre e-mail"

msgctxt "confirm_text"
msgid ""
"Your avatar is active once you click the link of the mail we sent you. "
"Nothing within a few minutes? Have a look in the spam folder."
msgstr ""
"Votre avatar est actif dès que vous cliquez sur le lien du message envoyé. "
"Rien après quelques minutes ? Regardez dans les indésirables."

#, php-format
msgctxt "confirmed"
msgid ""
"Your email is confirmed, %s is active. You can log in now, here and in-world."
msgstr ""
"Votre e-mail est confirmé, %s est actif. Vous pouvez vous connecter, ici et "
"dans le monde virtuel."

msgctxt "resend_title"
msgid "Get a new link"
msgstr "Recevoir un nouveau lien"

msgctxt "resend_button"
msgid "Send a new link"
msgstr "Envoyer un nouveau lien"

msgctxt "confirm_resent"
msgid "A new link is on its way."
msgstr "Un nouveau lien est en route."

#, php-format
msgctxt "confirm_resent_test"
msgid "Test site, no mail: confirm with this link: %s"
msgstr "Site de test, pas de mail : confirmez avec ce lien : %s"

msgctxt "avatar_name"
msgid "Avatar Name"
msgstr "Nom de l'avatar"

msgctxt "log_in"
msgid "Log in"
msgstr "Connexion"

msgctxt "logout"
msgid "Logout"
msgstr "Déconnexion"

msgctxt "login"
msgid "Avatar name or email"
msgstr "Nom de l’avatar ou e-mail"

msgctxt "forgot_title"
msgid "Lost Password"
msgstr "Mot de passe perdu"

msgctxt "forgot_text"
msgid ""
"Type the name of your avatar or your email: you will get a link to choose a "
"new password."
msgstr ""
"Tapez le nom de votre avatar ou votre e-mail : vous recevrez un lien pour "
"choisir un nouveau mot de passe."

msgctxt "forgot_button"
msgid "Send me a link"
msgstr "M’envoyer un lien"

msgctxt "forgot_sent"
msgid ""
"If an avatar has this name or this email, a link is on its way to its "
"address."
msgstr "Si un avatar a ce nom ou cet e-mail, un lien part vers son adresse."

msgctxt "forgot_test"
msgid ""
"Test site, no mail: the link of a new password is not shown here, the engine "
"API gives it (send: false)."
msgstr ""
"Site de test, pas de mail : le lien d’un nouveau mot de passe ne s’affiche "
"pas ici, l’API de l’engine le donne (send: false)."

msgctxt "reset_title"
msgid "Reset Password"
msgstr "Réinitialisation du mot de passe"

msgctxt "reset_text"
msgid "Choose the new password of your avatar."
msgstr "Choisissez le nouveau mot de passe de votre avatar."

msgctxt "reset_no_token"
msgid "This page opens from the link of the mail you received."
msgstr "Cette page s’ouvre depuis le lien du message reçu."

msgctxt "reset_button"
msgid "Save the new password"
msgstr "Enregistrer le mot de passe"

msgctxt "reset_done"
msgid "Your password is changed. You can log in with it now."
msgstr "Votre mot de passe est changé. Vous pouvez vous connecter avec."

msgctxt "new_password"
msgid "New password"
msgstr "Nouveau mot de passe"

msgctxt "current_password"
msgid "Current password"
msgstr "Mot de passe actuel"

msgctxt "account_title"
msgid "Avatar Profile"
msgstr "Profil de l’avatar"

msgctxt "born"
msgid "Born"
msgstr "Naissance"

msgctxt "profile_title"
msgid "Profile"
msgstr "Profil"

msgctxt "profile_text"
msgid ""
"What other people see of you in-world (the picture and the interests are set "
"in the viewer)."
msgstr ""
"Ce que les autres voient de vous dans le monde virtuel (la photo et les "
"centres d’intérêt se règlent dans le viewer)."

msgctxt "about"
msgid "About"
msgstr "À propos"

msgctxt "wants"
msgid "Wants to"
msgstr "J'aimerais"

msgctxt "skills"
msgid "Skills"
msgstr "Compétences"

msgctxt "languages"
msgid "Languages"
msgstr "Langues"

msgctxt "first_life"
msgid "Real Life"
msgstr "Vie réelle"

msgctxt "profile_url"
msgid "Web page"
msgstr "Page web"

msgctxt "save_button"
msgid "Save"
msgstr "Enregistrer"

msgctxt "profile_saved"
msgid "Your profile is saved."
msgstr "Votre profil est enregistré."

msgctxt "password_title"
msgid "Password"
msgstr "Mot de passe"

msgctxt "password_button"
msgid "Change the password"
msgstr "Changer le mot de passe"

msgctxt "password_saved"
msgid "Your password is changed."
msgstr "Votre mot de passe est changé."

#, php-format
msgctxt "email_pending"
msgid ""
"Your profile is saved. A link is on its way to %s: click it to make it your "
"email."
msgstr ""
"Votre profil est enregistré. Un lien part vers %s : cliquez dessus pour en "
"faire votre e-mail."

#, php-format
msgctxt "email_pending_test"
msgid ""
"Your profile is saved. Test site, no mail: confirm %1$s with this link: %2$s"
msgstr ""
"Votre profil est enregistré. Site de test, pas de mail : confirmez %1$s avec "
"ce lien : %2$s"

#, php-format
msgctxt "email_changed"
msgid "Your email is now %s."
msgstr "Votre e-mail est maintenant %s."

msgctxt "manage_title"
msgid "Avatars"
msgstr "Avatars"

msgctxt "search_avatars"
msgid "Name or email"
msgstr "Nom ou e-mail"

msgctxt "search"
msgid "Search"
msgstr "Chercher"

msgctxt "no_avatars"
msgid "No result"
msgstr "Aucun résultat"

#, php-format
msgctxt "avatars_count"
msgid "%s avatars"
msgstr ""

msgctxt "status"
msgid "Status"
msgstr "Statut"

msgctxt "last_seen"
msgid "Last Seen"
msgstr "Dernière apparition"

msgctxt "created"
msgid "Created"
msgstr "Créé"

msgctxt "actions"
msgid "Actions"
msgstr ""

msgctxt "god"
msgid "God"
msgstr "Dieu"

msgctxt "online"
msgid "Online"
msgstr "En ligne"

msgctxt "active"
msgid "Active"
msgstr "Actif"

msgctxt "inactive"
msgid "Inactive"
msgstr "Inactif"

msgctxt "action_enable"
msgid "Enable"
msgstr "Activer"

msgctxt "action_disable"
msgid "Disable"
msgstr "Désactiver"

msgctxt "action_reset"
msgid "Password link"
msgstr "Lien mot de passe"

msgctxt "action_delete"
msgid "Delete"
msgstr "Supprimer"

#, php-format
msgctxt "delete_confirm"
msgid "Delete %s for good, with its inventory?"
msgstr "Supprimer %s pour de bon, avec son inventaire ?"

#, php-format
msgctxt "manage_enable"
msgid "%s is enabled."
msgstr "%s est activé."

#, php-format
msgctxt "manage_disable"
msgid "%s is disabled."
msgstr "%s est désactivé."

#, php-format
msgctxt "manage_reset"
msgid "A link to choose a new password is on its way to %s."
msgstr "Un lien pour choisir un nouveau mot de passe part vers %s."

#, php-format
msgctxt "manage_delete"
msgid "%s is deleted."
msgstr "%s est supprimé."

msgctxt "error_required"
msgid "Please fill in every field."
msgstr "Merci de remplir tous les champs."

msgctxt "error_password_match"
msgid "The two passwords are not the same."
msgstr "Les deux mots de passe ne sont pas les mêmes."

#, php-format
msgctxt "error_terms"
msgid "You must agree to the terms on page %s."
msgstr "Vous devez accepter les conditions de la page %s."

msgctxt "error_current_password"
msgid "The current password is wrong."
msgstr "Le mot de passe actuel est faux."

msgctxt "error_forbidden"
msgid "This is not allowed."
msgstr "Ce n’est pas permis."

msgctxt "error_nonce"
msgid "This page has expired, please try again."
msgstr "Cette page a expiré, merci de recommencer."

msgctxt "error_not_found"
msgid "There is no such avatar."
msgstr "Cet avatar n’existe pas."

msgctxt "error_invalid_request"
msgid "This cannot be done."
msgstr "Ce n’est pas possible."

msgctxt "error_invalid_document"
msgid "This cannot be done."
msgstr "Ce n’est pas possible."

msgctxt "error_type_conflict"
msgid "This cannot be done."
msgstr "Ce n’est pas possible."

msgctxt "error_unauthorized"
msgid "The grid cannot be reached right now. Please try again later."
msgstr "La grille ne répond pas pour l’instant. Merci de réessayer plus tard."

msgctxt "error_method_not_allowed"
msgid "This cannot be done."
msgstr "Ce n’est pas possible."

msgctxt "error_channel_unavailable"
msgid "The grid cannot be reached right now. Please try again later."
msgstr "La grille ne répond pas pour l’instant. Merci de réessayer plus tard."

msgctxt "error_instance_failed"
msgid "The grid cannot be reached right now. Please try again later."
msgstr "La grille ne répond pas pour l’instant. Merci de réessayer plus tard."

msgctxt "error_internal_error"
msgid "The grid cannot be reached right now. Please try again later."
msgstr "La grille ne répond pas pour l’instant. Merci de réessayer plus tard."

msgctxt "error_sign_in_refused"
msgid "The name or the password is wrong."
msgstr "Le nom ou le mot de passe est faux."

msgctxt "error_account_disabled"
msgid "This avatar is disabled. Contact the managers of the grid."
msgstr "Cet avatar est désactivé. Contactez les gestionnaires de la grille."

msgctxt "error_email_unconfirmed"
msgid ""
"This avatar is not active yet: confirm your email with the link of the mail "
"we sent you."
msgstr ""
"Cet avatar n’est pas encore actif : confirmez votre e-mail avec le lien du "
"message envoyé."

msgctxt "error_name_invalid"
msgid ""
"The first and the last name are made of letters, digits and hyphens, without "
"accents."
msgstr ""
"Le prénom et le nom sont faits de lettres, de chiffres et de tirets, sans "
"accents."

msgctxt "error_name_reserved"
msgid "This name is reserved, please choose another one."
msgstr "Ce nom est réservé, merci d’en choisir un autre."

msgctxt "error_name_taken"
msgid "An avatar already has this name, please choose another one."
msgstr "Un avatar porte déjà ce nom, merci d’en choisir un autre."

msgctxt "error_password_required"
msgid "Please fill in every field."
msgstr "Merci de remplir tous les champs."

msgctxt "error_password_invalid"
msgid "The password must have 6 to 16 characters, without double quote."
msgstr ""
"Le mot de passe doit avoir de 6 à 16 caractères, sans guillemet double."

msgctxt "error_email_invalid"
msgid "This email address is not valid."
msgstr "Cette adresse e-mail n’est pas valide."

msgctxt "error_email_required"
msgid "This avatar has no email address."
msgstr "Cet avatar n’a pas d’adresse e-mail."

msgctxt "error_model_unknown"
msgid "This outfit is not available, please choose another one."
msgstr "Cet ensemble n’est pas disponible, merci d’en choisir un autre."

msgctxt "error_link_invalid"
msgid "This cannot be done."
msgstr "Ce n’est pas possible."

msgctxt "error_field_unknown"
msgid "This cannot be done."
msgstr "Ce n’est pas possible."

msgctxt "error_token_refused"
msgid ""
"This link does not work: it has expired or it was already used. Ask for a "
"new one."
msgstr ""
"Ce lien ne marche pas : il a expiré ou il a déjà servi. Demandez-en un "
"nouveau."

msgctxt "error_no_confirmation_pending"
msgid "This avatar does not wait for the confirmation of its email."
msgstr "Cet avatar n’attend pas de confirmation de son e-mail."

msgctxt "error_mail_failed"
msgid "The mail could not be sent. Please try again later."
msgstr "Le message n’a pas pu partir. Merci de réessayer plus tard."
