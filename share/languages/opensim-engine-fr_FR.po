msgctxt "offline"
msgid "Offline"
msgstr "Hors ligne"

msgctxt "degraded"
msgid "Degraded"
msgstr "Dégradé"

msgctxt "setting_login"
msgid "Login URI"
msgstr "URI de connexion"

msgctxt "setting_login_help"
msgid ""
"The address the viewers log in at, and ask what the grid says of itself "
"(get_grid_info)."
msgstr ""
"L’adresse où les viewers se connectent, et demandent ce que la grille dit "
"d’elle-même (get_grid_info)."

msgctxt "setting_gatekeeper"
msgid "Gatekeeper"
msgstr "Gatekeeper"

msgctxt "setting_gatekeeper_help"
msgid "The address other grids reach this one by (hypergrid)."
msgstr ""
"L’adresse par laquelle les autres grilles atteignent celle-ci (hypergrid)."

msgctxt "setting_uas"
msgid "User agent service"
msgstr "Service des agents"

msgctxt "setting_uas_help"
msgid ""
"Where the avatars of this grid are known when they visit other grids "
"(hypergrid)."
msgstr ""
"Là où les avatars de cette grille sont connus quand ils visitent d’autres "
"grilles (hypergrid)."

msgctxt "setting_welcome"
msgid "Splash"
msgstr "Splash"

msgctxt "setting_welcome_help"
msgid ""
"The welcome page displayed in the viewer with the login form. A short, no-"
"scroll page, with only essential info. It is required, or at least highly "
"recommended."
msgstr ""
"La page de bienvenue affichée dans le visualiseur avec le formulaire de "
"connexion. Une page courte, sans défilement, avec seulement le contenu "
"essentiel. Requise, ou tout au moins hautement recommandée."

msgctxt "setting_economy"
msgid "Economy"
msgstr "Économie"

msgctxt "setting_economy_help"
msgid ""
"Currencies and some other services queried by the viewer. They are not "
"accessed directly by the user."
msgstr ""
"Devises et quelques autres services interrogés par le visualiseur. Ils ne "
"sont pas accessibles par l'utilisateur."

msgctxt "setting_about"
msgid "About this grid"
msgstr "À propos de cette grille"

msgctxt "setting_about_help"
msgid ""
"Detailed info page on your website, via a link displayed on the viewer login "
"page."
msgstr ""
"Page d'informations détaillées, sur votre site web, via un lien affiché sur "
"la page de connexion du visualiseur."

msgctxt "setting_register"
msgid "Registration page"
msgstr "Page d'enregistrement"

msgctxt "setting_register_help"
msgid "Link to the user registration."
msgstr "Lien vers l'inscription."

msgctxt "setting_help"
msgid "Help"
msgstr "Aide"

msgctxt "setting_help_help"
msgid "Link to a help page on your website."
msgstr "Lien vers une page d'aide sur votre site web."

msgctxt "setting_password"
msgid "Password recovery"
msgstr "Récupération de mot de passe"

msgctxt "setting_password_help"
msgid "Link to lost password page."
msgstr "Lien vers la page de récupération de mot de passe."

msgctxt "setting_grid_status"
msgid "Grid Status"
msgstr "Statut de la grille"

msgctxt "setting_grid_status_help"
msgid "The page of the status of the grid."
msgstr "La page de l’état de la grille."

msgctxt "setting_grid_status_rss"
msgid "Grid status feed"
msgstr "Flux de l’état de la grille"

msgctxt "setting_grid_status_rss_help"
msgid "The feed of the status of the grid the viewers read (RSS)."
msgstr "Le flux de l’état de la grille que lisent les viewers (RSS)."

msgctxt "setting_web_profile"
msgid "Avatar profile"
msgstr "Profil d'avatar"

msgctxt "setting_web_profile_help"
msgid "The base URL for avatar web profiles."
msgstr "La base d'URL pour les profils d'avatars."

msgctxt "setting_web_search"
msgid "Web Search"
msgstr "Recherche web"

msgctxt "setting_web_search_help"
msgid ""
"Web tab of viewer search windows. Relevant if you have a search page "
"providing content from the grid."
msgstr ""
"Onglet web de la fenêtre de recherche. Utile si vous avez une page de "
"recherche fournissant des résultats pour la grille."

msgctxt "setting_destination_guide"
msgid "Destinations Guide"
msgstr "Guide des destinations"

msgctxt "setting_destination_guide_help"
msgid ""
"Destinations guide is a Viewer 3 feature, providing a window with places "
"suggestions."
msgstr ""
"Le guide des destinations est une fonctionnalité de Viewer 3, qui propose "
"une fenêtre avec des suggestions de lieux."

msgctxt "setting_message_url"
msgid "Message of the day"
msgstr "Message du jour"

msgctxt "setting_message_url_help"
msgid "The message the viewers show at login."
msgstr "Le message que les viewers affichent à la connexion."

msgctxt "setting_search_service"
msgid "Search Service"
msgstr "Service de recherche"

msgctxt "setting_search_service_help"
msgid ""
"Search service used by the viewer. Search can be provided by the simulator "
"core (limited), or by an external service for additional functionalities "
"(like events). Requires OpenSimSearch.Modules.dll."
msgstr ""
"Service de recherche utilisé par le visualiseur. La recherche peut être "
"fournie par le coeur du simulateur (limité) ou par un service externe pour "
"des fonctionnalités supplémentaires (comme les événements). Nécessite "
"OpenSimSearch.Modules.dll."

msgctxt "setting_data_service"
msgid "Data service"
msgstr "Service de données"

msgctxt "setting_data_service_help"
msgid ""
"Where the simulators register their regions, so that the search finds them. "
"Not a page."
msgstr ""
"Là où les simulateurs inscrivent leurs régions, pour que la recherche les "
"trouve. Pas une page."

msgctxt "setting_offline_messages"
msgid "Offline messages"
msgstr "Messages hors-ligne"

msgctxt "setting_offline_messages_help"
msgid ""
"Needed by viewers to keep messages while user is offline and deliver them "
"when they come back online. Internal service, not accessed directly by the "
"user."
msgstr ""
"Requis par les visualiseurs pour conserver les messages envoyés lorsque "
"l'utilisateur est hors-ligne, et les lui délivrer lorsqu'il revient en "
"ligne. Service interne, non accessible par l'utilisateur."

msgctxt "setting_offline_module"
msgid "Offline messages module"
msgstr "Module des messages hors ligne"

msgctxt "setting_offline_module_help"
msgid ""
"The module of the simulators that keeps the messages of the avatars who are "
"away: V2 by Robust, V1 by the helpers."
msgstr ""
"Le module des simulateurs qui garde les messages des avatars absents : V2 "
"par Robust, V1 par les helpers."

msgctxt "setting_money_script_key"
msgid "Money script key"
msgstr "Clé des scripts de monnaie"

msgctxt "setting_money_script_key_help"
msgid ""
"The key the currency services and the money server share: never shown, only "
"whether it is set."
msgstr ""
"La clé que partagent les services de monnaie et le serveur de monnaie : "
"jamais affichée, seulement si elle est définie."

msgctxt "setting_helpers"
msgid "Helpers base"
msgstr "Base des helpers"

msgctxt "setting_helpers_help"
msgid "The base of the pages and services of the helpers."
msgstr "La base des pages et des services des helpers."

msgctxt "setting_directory"
msgid "Directory"
msgstr "Annuaire"

msgctxt "setting_directory_help"
msgid "The page of the grid in the shared directory of the regions."
msgstr "La page de la grille dans l’annuaire partagé des régions."

msgctxt "setting_cache_assets"
msgid "Picture cache"
msgstr "Cache des images"

msgctxt "setting_cache_assets_help"
msgid ""
"The folder the pictures are kept in: without it, they are made again on "
"every request."
msgstr ""
"Le dossier où les images sont gardées : sans lui, elles sont refaites à "
"chaque demande."

msgctxt "setting_cache_tasks"
msgid "Task state"
msgstr "État des tâches"

msgctxt "setting_cache_tasks_help"
msgid ""
"The folder of the state of the tasks: without it, no task runs and the "
"search index never fills."
msgstr ""
"Le dossier de l’état des tâches : sans lui, aucune tâche ne tourne et "
"l’index de recherche ne se remplit jamais."

msgctxt "usage_robust_simulators"
msgid "Robust service, used by the simulators"
msgstr "Service de Robust, utilisé par les simulateurs"

msgctxt "usage_robust_viewers"
msgid "Robust service, used by the viewers and the other grids"
msgstr "Service de Robust, utilisé par les visualiseurs et les autres grilles"

msgctxt "usage_helper_simulators"
msgid "Helper called by the simulators"
msgstr "Helper appelé par les simulateurs"

msgctxt "usage_helper_viewers"
msgid "Helper called by the viewer"
msgstr "Helper appelé par le visualiseur"

msgctxt "usage_page"
msgid "Web page, shown by the viewer or the web site"
msgstr "Page web, affichée par le visualiseur ou le site web"

msgctxt "usage_web_tool"
msgid "Web tool, used with a script in-world"
msgstr "Outil web, utilisé avec un script dans le monde"

msgctxt "usage_task"
msgid "Task of the grid, run in the background"
msgstr "Tâche de la grille, exécutée en arrière-plan"

msgctxt "usage_web_assets"
msgid "Web assets, for the web sites"
msgstr "Web assets, pour les sites web"

msgctxt "service_asset"
msgid "Assets service"
msgstr "Service des assets"

msgctxt "service_asset_help"
msgid ""
"The assets of the grid (textures, sounds, objects...): the simulators read "
"and store them."
msgstr "Les assets de la grille (textures, sons, objets...) : les simulateurs les lisent et les enregistrent."

msgctxt "service_inventory"
msgid "Inventory service"
msgstr "Service des inventaires"

msgctxt "service_inventory_help"
msgid "The inventories of the avatars."
msgstr "Les inventaires des avatars."

msgctxt "service_grid"
msgid "Grid service"
msgstr "Service de la grille"

msgctxt "service_grid_help"
msgid ""
"The regions of the grid: where each one is, and which simulator runs it."
msgstr "Les régions de la grille : où chacune se trouve, et quel simulateur la fait tourner."

msgctxt "service_estate"
msgid "Estate service"
msgstr "Service des domaines"

msgctxt "service_estate_help"
msgid "The estates of the regions, their owners and their managers."
msgstr "Les domaines des régions, leurs propriétaires et leurs gérants."

msgctxt "service_authentication"
msgid "Authentication service"
msgstr "Service d'authentification"

msgctxt "service_authentication_help"
msgid "The passwords of the accounts, and their sessions."
msgstr "Les mots de passe des comptes, et leurs sessions."

msgctxt "service_avatar"
msgid "Avatar service"
msgstr "Service des avatars"

msgctxt "service_avatar_help"
msgid "The appearance of the avatars: what they wear."
msgstr "L'apparence des avatars : ce qu'ils portent."

msgctxt "service_agent_preferences"
msgid "Agent preferences service"
msgstr "Service des préférences"

msgctxt "service_agent_preferences_help"
msgid "The preferences of the avatars the grid keeps (language, maturity)."
msgstr "Les préférences des avatars que garde la grille (langue, maturité)."

msgctxt "service_presence"
msgid "Presence service"
msgstr "Service de présence"

msgctxt "service_presence_help"
msgid "Who is in the world now, and where."
msgstr "Qui est dans le monde en ce moment, et où."

msgctxt "service_user_account"
msgid "User account service"
msgstr "Service des comptes"

msgctxt "service_user_account_help"
msgid "The accounts of the avatars: their names, emails and levels."
msgstr "Les comptes des avatars : leurs noms, e-mails et niveaux."

msgctxt "service_grid_user"
msgid "Grid user service"
msgstr "Service des positions"

msgctxt "service_grid_user_help"
msgid "The last position and the home of each avatar."
msgstr "La dernière position et le domicile de chaque avatar."

msgctxt "service_friends"
msgid "Friends service"
msgstr "Service des amis"

msgctxt "service_friends_help"
msgid "The friendships of the avatars."
msgstr "Les amitiés des avatars."

msgctxt "service_map_image"
msgid "Map tiles service"
msgstr "Service des tuiles de la carte"

msgctxt "service_map_image_help"
msgid "The tiles of the map of the world: the simulators add them."
msgstr "Les tuiles de la carte du monde : les simulateurs les ajoutent."

msgctxt "service_mute_list"
msgid "Mute list service"
msgstr "Service des listes de blocage"

msgctxt "service_mute_list_help"
msgid "What each avatar blocks."
msgstr "Ce que chaque avatar bloque."

msgctxt "service_bakes"
msgid "Baked textures service"
msgstr "Service des textures cuites"

msgctxt "service_bakes_help"
msgid "The baked textures of the avatars, shared between the simulators."
msgstr "Les textures cuites des avatars, partagées entre les simulateurs."

msgctxt "service_groups"
msgid "Groups service"
msgstr "Service des groupes"

msgctxt "service_groups_help"
msgid "The groups of the avatars, their members, roles and notices."
msgstr "Les groupes des avatars, leurs membres, rôles et annonces."

msgctxt "service_profile"
msgid "Profiles service"
msgstr "Service des profils"

msgctxt "service_profile_help"
msgid "The profiles of the avatars, their picks and their classifieds."
msgstr "Les profils des avatars, leurs favoris et leurs petites annonces."

msgctxt "service_get_grid_info"
msgid "Grid info"
msgstr "Infos sur la grille"

msgctxt "service_get_grid_info_help"
msgid "What the grid says of itself to the viewers (get_grid_info)."
msgstr "Ce que la grille dit d'elle-même aux visualiseurs (get_grid_info)."

msgctxt "service_hg_friends"
msgid "Hypergrid friends service"
msgstr "Service des amis hypergrid"

msgctxt "service_hg_friends_help"
msgid "The friendships with the avatars of other grids (hypergrid)."
msgstr "Les amitiés avec les avatars d'autres grilles (hypergrid)."

msgctxt "service_hg_asset"
msgid "Hypergrid assets service"
msgstr "Service des assets hypergrid"

msgctxt "service_hg_asset_help"
msgid "The assets the other grids ask for (hypergrid)."
msgstr "Les assets que demandent les autres grilles (hypergrid)."

msgctxt "service_hg_inventory"
msgid "Hypergrid inventory service"
msgstr "Service des inventaires hypergrid"

msgctxt "service_hg_inventory_help"
msgid ""
"The inventories the avatars of this grid reach from other grids (hypergrid)."
msgstr "Les inventaires que les avatars de cette grille atteignent depuis d'autres grilles (hypergrid)."

msgctxt "service_hg_groups"
msgid "Hypergrid groups service"
msgstr "Service des groupes hypergrid"

msgctxt "service_hg_groups_help"
msgid "The groups the avatars of other grids reach (hypergrid)."
msgstr "Les groupes qu'atteignent les avatars d'autres grilles (hypergrid)."

msgctxt "service_map"
msgid "Map service"
msgstr "Service de la carte"

msgctxt "service_map_help"
msgid "The tiles of the map the viewers and the other grids read."
msgstr "Les tuiles de la carte que lisent les visualiseurs et les autres grilles."

msgctxt "service_currency"
msgid "Currency helper"
msgstr "Helper de la monnaie"

msgctxt "service_currency_help"
msgid ""
"The currency of the grid, called by the viewer (currency.php): the balance, "
"the cost of currency."
msgstr "La monnaie de la grille, appelée par le visualiseur (currency.php) : le solde, le prix de la monnaie."

msgctxt "service_landtool"
msgid "Land tool helper"
msgstr "Helper des terrains"

msgctxt "service_landtool_help"
msgid "The land sales the viewer calls (landtool.php)."
msgstr "Les ventes de terrain qu'appelle le visualiseur (landtool.php)."

msgctxt "service_parser"
msgid "Search parser"
msgstr "Analyseur de la recherche"

msgctxt "service_parser_help"
msgid "Reads the regions registered with the search: a task of the grid."
msgstr "Lit les régions inscrites à la recherche : une tâche de la grille."

msgctxt "service_events_parser"
msgid "Events parser"
msgstr "Analyseur des événements"

msgctxt "service_events_parser_help"
msgid "Reads the events of the calendar: a task of the grid."
msgstr "Lit les événements du calendrier : une tâche de la grille."

msgctxt "service_text_images"
msgid "Text to image"
msgstr "Texte en image"

msgctxt "service_text_images_help"
msgid "Makes an image of a text, for a script in-world (textgen.php)."
msgstr "Fait une image d'un texte, pour un script dans le monde (textgen.php)."

msgctxt "service_assets"
msgid "Web Assets Server"
msgstr "Serveur web de ressources"

msgctxt "service_assets_help"
msgid ""
"A web assets server is required to display in-world assets (from the grid) "
"on the website (e.g. profile pictures)."
msgstr "Un serveur web de ressources (web assets server) est requis pour afficher les images du monde virtuel sur le site web (par exempe les images de profil)."

msgctxt "service_instant_message"
msgid "Instant messages service"
msgstr "Service des messages instantanés"

msgctxt "service_instant_message_help"
msgid "The messages between the avatars of different grids (hypergrid)."
msgstr "Les messages entre les avatars de grilles différentes (hypergrid)."

msgctxt "health_unset"
msgid "Not set: neither served nor tested."
msgstr ""

msgctxt "health_third_party"
msgid "This service requires a separate web application."
msgstr "Ce service requiert une application web distincte."

msgctxt "presence"
msgid "Presence"
msgstr "Présence"

