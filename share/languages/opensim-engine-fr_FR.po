msgctxt "service_asset"
msgid "Assets service"
msgstr "Service des assets"

msgctxt "service_asset_help"
msgid ""
"The assets of the grid (textures, sounds, objects...): the simulators read "
"and store them."
msgstr ""
"Les assets de la grille (textures, sons, objets...) : les simulateurs les "
"lisent et les enregistrent."

msgctxt "service_inventory"
msgid "Inventory service"
msgstr "Service des inventaires"

msgctxt "service_inventory_help"
msgid "The inventories of the avatars."
msgstr "Les inventaires des avatars."

msgctxt "service_grid"
msgid "Grid service"
msgstr "Service de la grille"

msgctxt "service_grid_help"
msgid ""
"The regions of the grid: where each one is, and which simulator runs it."
msgstr ""
"Les régions de la grille : où chacune se trouve, et quel simulateur la fait "
"tourner."

msgctxt "service_estate"
msgid "Estate service"
msgstr "Service des domaines"

msgctxt "service_estate_help"
msgid "The estates of the regions, their owners and their managers."
msgstr "Les domaines des régions, leurs propriétaires et leurs gérants."

msgctxt "service_authentication"
msgid "Authentication service"
msgstr "Service d'authentification"

msgctxt "service_authentication_help"
msgid "The passwords of the accounts, and their sessions."
msgstr "Les mots de passe des comptes, et leurs sessions."

msgctxt "service_avatar"
msgid "Avatar service"
msgstr "Service des avatars"

msgctxt "service_avatar_help"
msgid "The appearance of the avatars: what they wear."
msgstr "L'apparence des avatars : ce qu'ils portent."

msgctxt "service_agent_preferences"
msgid "Agent preferences service"
msgstr "Service des préférences"

msgctxt "service_agent_preferences_help"
msgid "The preferences of the avatars the grid keeps (language, maturity)."
msgstr "Les préférences des avatars que garde la grille (langue, maturité)."

msgctxt "service_presence"
