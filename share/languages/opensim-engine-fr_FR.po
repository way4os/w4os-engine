msgstr "Par défaut : l'adresse de Robust."

msgctxt "uri_default_login"
msgid "Default: the login URI."
msgstr "Par défaut : l'URI de connexion."

msgctxt "setting_profile_page"
msgid "Profile Page"
msgstr "Page de profil"

msgctxt "setting_exclude_from_stats"
msgid "Exclude from stats"
msgstr "Exclure des statistiques"

msgctxt "setting_exclude_from_stats_help"
msgid ""
"Accounts without email address are usually test or service accounts, created "
"from the console. Uncheck only if you have real avatars without email "
"address."
msgstr ""
"Les comptes sans adresse e-mail sont généralement des comptes de test ou de "
"service, créés depuis la console. Décochez uniquement si vous avez de vrais "
"avatars sans adresse e-mail."

msgctxt "exclude_models"
msgid "Models"
msgstr "Modèles"

msgctxt "exclude_nomail"
msgid "Accounts without mail address"
msgstr "Comptes sans adresse e-mail"

msgctxt "exclude_hypergrid"
msgid "Hypergrid visitors"
msgstr "Visiteurs hypergrid"

msgctxt "setting_allow_multiple_avatars"
msgid "Allow multiple avatars"
msgstr "Autoriser plusieurs avatars"

msgctxt "setting_allow_multiple_avatars_help"
msgid "Allow more than one avatar for a single email address."
msgstr "Autoriser plus d'un avatar pour une seule adresse e-mail."

msgctxt "setting_reserved_names"
msgid "Forbidden names"
msgstr "Noms interdits"

msgctxt "setting_reserved_names_help"
msgid ""
"No new avatar may have one of them as its first or last name, nor the name "
"of the grid."
msgstr ""
"Aucun nouvel avatar ne peut avoir l'un d'eux comme prénom ou nom, ni le nom "
"de la grille."

