msgstr "Robust-URI"

msgctxt "setting_robust_uri_help"
msgid ""
"The private address of Robust, which the simulators call for the services of "
"the grid."
msgstr ""
"Die private Adresse von Robust, die die Simulatoren für die Dienste des "
"Grids aufrufen."

msgctxt "setting_robust_database"
msgid "ROBUST Database"
msgstr "ROBUST-Datenbank"

