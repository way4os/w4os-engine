msgctxt "region_flag_default_region_help"
msgid ""
"Where avatars arrive when they do not ask for a region; one at random when "
"there are several."
msgstr ""
"Wo Avatare ankommen, wenn sie keine Region angeben; eine zufällige, wenn es "
"mehrere gibt."

msgctxt "region_flag_fallback_region_help"
msgid "Where avatars are sent when the region they ask for is down."
msgstr ""
"Wohin Avatare geschickt werden, wenn die gewünschte Region nicht läuft."

msgctxt "region_flag_region_online_help"
msgid ""
"The region is running: set when it comes online, unset when it leaves the "
"grid."
msgstr ""
"Die Region läuft: gesetzt, wenn sie online geht, entfernt, wenn sie das Grid "
"verlässt."

msgctxt "region_flag_no_direct_login_help"
msgid "Avatars cannot log in to it directly by its name."
msgstr "Avatare können sich nicht direkt über ihren Namen dort anmelden."

msgctxt "region_flag_persistent_help"
msgid "Kept in the list of the grid when it leaves."
msgstr "Bleibt in der Liste des Grids, wenn sie es verlässt."

msgctxt "region_flag_locked_out_help"
msgid "The region is not allowed to register."
msgstr "Die Region darf sich nicht anmelden."

msgctxt "region_flag_no_move_help"
msgid "The region cannot be moved on the map."
msgstr "Die Region kann auf der Karte nicht verschoben werden."

msgctxt "region_flag_reservation_help"
msgid "An inactive reservation of a place on the map."
msgstr "Eine inaktive Reservierung eines Platzes auf der Karte."

msgctxt "region_flag_authenticate_help"
