msgid "Console User"
msgstr "Konsolenbenutzer"

msgctxt "setting_console_pass"
msgid "Console Password"
msgstr "Konsolenpasswort"

msgctxt "setting_console_port"
msgid "Console Port"
msgstr "Konsolenport"

msgctxt "setting_console_port_help"
msgid "The port of the remote console of Robust, what drives it."
msgstr "Der Port der Fernkonsole von Robust, über die es gesteuert wird."

msgctxt "setting_assets_service_uri"
msgid "Assets Service URI"
msgstr "URI des Asset-Dienstes"

msgctxt "setting_profile_service_uri"
msgid "Profile Service URI"
msgstr "URI des Profildienstes"

msgctxt "uri_default_robust"
msgid "Default: the address of Robust."
msgstr "Standard: die Adresse von Robust."

msgctxt "uri_default_login"
msgid "Default: the login URI."
msgstr "Standard: die Login-URI."

msgctxt "setting_profile_page"
msgid "Profile Page"
msgstr "Profilseite"

msgctxt "setting_exclude_from_stats"
msgid "Exclude from stats"
msgstr "Aus der Statistik ausschließen"

msgctxt "setting_exclude_from_stats_help"
msgid ""
"Accounts without email address are usually test or service accounts, created "
"from the console. Uncheck only if you have real avatars without email "
"address."
msgstr ""
"Konten ohne E-Mail-Adresse sind normalerweise Test- oder Servicekonten, die "
"von der Konsole aus erstellt wurden. Deaktiviere dies nur, wenn du echte "
"Avatare ohne E-Mail-Adresse hast."

msgctxt "exclude_models"
msgid "Models"
msgstr "Modelle"

msgctxt "exclude_nomail"
msgid "Accounts without mail address"
msgstr "Konten ohne E-Mail-Adresse"

msgctxt "exclude_hypergrid"
msgid "Hypergrid visitors"
msgstr "Hypergrid-Besucher"

msgctxt "setting_allow_multiple_avatars"
msgid "Allow multiple avatars"
msgstr "Erlaube mehrere Avatare"

msgctxt "setting_allow_multiple_avatars_help"
msgid "Allow more than one avatar for a single email address."
msgstr "Erlaube mehr als einen Avatar für eine einzige E-Mail-Adresse."

msgctxt "setting_reserved_names"
msgid "Forbidden names"
msgstr "Verbotene Namen"

msgctxt "setting_reserved_names_help"
msgid ""
"No new avatar may have one of them as its first or last name, nor the name "
"of the grid."
msgstr ""
"Kein neuer Avatar darf einen davon als Vor- oder Nachnamen haben, ebenso "
"wenig den Namen des Grids."

