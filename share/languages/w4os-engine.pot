msgctxt "notice_map_package"
msgid "The 3D map needs the package {package}: without it, the simulators cannot write its tiles."
msgstr ""

msgctxt "notice_map_core"
msgid "The 3D map needs a newer OpenSimulator: this one cannot write its tiles where it runs from."
msgstr ""

msgctxt "notice_map_folder"
msgid "The 3D map needs {folder} writable by {account}."
msgstr ""

msgctxt "notice_robust_restart_roles"
msgid "Robust reads {key} when it starts: restart Robust ({restart}) so it gives the region these roles when it registers again."
msgstr ""

msgctxt "notice_robust_config_line"
msgid "{file} cannot be written by this process: set {line} in its [{section}], then restart Robust ({restart})."
msgstr ""

msgctxt "notice_robust_config_remove"
msgid "{file} cannot be written by this process: remove {key} from its [{section}], then restart Robust ({restart})."
msgstr ""

msgctxt "notice_robust_config_elsewhere"
msgid "The config of Robust is not on this machine: set {line} in its [{section}], so the region keeps its roles when it registers again."
msgstr ""

msgctxt "notice_start_simulator"
msgid "Start the simulator {slug}: {command}"
msgstr ""

msgctxt "notice_start_simulator_regions"
msgid "The simulator {slug} loads its new regions when it starts: {command}"
msgstr ""

msgctxt "notice_region_roles_later"
msgid "Robust gives {region} its roles ({roles}) from its config, read when it starts: restart Robust ({restart}) before starting {slug}, or once the region runs: {command}"
msgstr ""

msgctxt "notice_plan_reserves_nothing"
msgid "A plan reserves nothing: the places and the ports it proposes are the free ones now, chosen again when it is applied. Apply a plan before planning the next one, or give the regions in one file."
msgstr ""

msgctxt "notice_import_read_access"
msgid "The user that runs the import cannot read {paths}: give it read access to them (setfacl -R -m u:<user>:rX on the etc, var/data and var/cache of the older install) before applying, nothing is written until then."
msgstr ""

msgctxt "notice_import_stop_source"
msgid "The simulator that runs {regions} now keeps running until it is stopped: stop it and keep it from starting again (its cron, its screen) before this one starts, the database is the same."
msgstr ""

msgctxt "notice_import_no_region"
msgid "No region was found for {simulator} in {folder}, the folder its config names: check that it is the one it reads before applying, nothing of its regions would be copied."
msgstr ""

msgctxt "notice_import_module_package"
msgid "The module {module} ({key} of [{section}]) is not installed for this core: the simulator would not load it. Install its package (apt install {package}) and add {name} to EnabledModules of w4os.conf, or leave the setting out."
msgstr ""

msgctxt "notice_import_module_missing"
msgid "The module {module} ({key} of [{section}]) is in neither the core nor the modules of this install: the simulator would not load it. Put a build of it for this core in {folder} and add {name} to EnabledModules of w4os.conf, or leave the setting out."
msgstr ""

msgctxt "notice_import_module_found"
msgid "The module {module} ({key} of [{section}]) is in neither the core nor the modules of this install, the older install has it in {file}: the simulator would not load it. Put a build of it for this core in {folder} (a module is built for a version of OpenSimulator: that file only if both cores are the same version) and add {name} to EnabledModules of w4os.conf, or leave the setting out."
msgstr ""

msgctxt "notice_import_enable_start"
msgid "Then: {enable}, {start}."
msgstr ""

msgctxt "notice_restart_grid"
msgid "Grid restart is required: {restart}."
msgstr ""

msgctxt "notice_restart_simulators"
msgid "Simulator(s) restart is required: {restart}."
msgstr ""

msgctxt "notice_import_stop_grid"
msgid "The old Robust of {grid} keeps running until it is stopped: stop it and keep it from starting again (its service, its cron, its screen), its ports {ports} are the ones of the grid here, its database the same."
msgstr ""

msgctxt "notice_in_place_enable"
msgid "The grid is registered in place, disabled. Stop its own start first (kickstart.sh --in-place does it), or by hand: its cron or its service set aside, its running instances stopped (kill -TERM: a Robust with a remote console has no screen). Then {enable}, then {start}."
msgstr ""

msgctxt "notice_in_place_unwritable"
msgid "Its instances run as the account {account}, which cannot write in {folders} (folders of {owner}). The install is left as it is: they cannot run until {account} can write there."
msgstr ""

msgctxt "notice_region_removed"
msgid "{region} is out of {simulator}: its region file is {file} now (named back, the region is back). What it holds stays in the database of {simulator}. Give it to another simulator with: {command}"
msgstr ""

msgctxt "notice_install_account"
msgid "The instances run as {account}, the owner of the install, and its site is served as {web}: SystemUser, WebUser and WebGroup of {conf}. The service takes the account with: {command}"
msgstr ""

msgctxt "notice_import_switch"
msgid "Then switch: {command} (the grid and its simulators enabled and started here)."
msgstr ""

msgctxt "notice_restore_estate_missing"
msgid "The regions {regions} have no estate in {database}, the database of the grid here, which is kept as it is: they would start with none. Restore their estate there, or link them to one (estate link region) before starting."
msgstr ""

msgctxt "notice_restore_estate_unchecked"
msgid "The estates of the regions could not be checked in {database}, the database of the grid here, which is kept as it is: check that they are there before starting."
msgstr ""

msgctxt "notice_restore_start"
msgid "Start {instance} once it is restored: {command}"
msgstr ""

msgctxt "notice_mail_sent_if_known"
msgid "When an avatar has this name or this email, a mail was sent to it."
